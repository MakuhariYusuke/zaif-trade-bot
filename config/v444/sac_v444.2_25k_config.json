{
  "model_name": "sac_v444.2_25k_test",
  "version": "4.4.4.2",
  "algorithm": "sac",
  "total_timesteps": 25000,
  "description": "SAC v444.2: 25k steps test with continuous actions and unified config",

  "training": {
    "algorithm": "sac",
    "data_config": {
      "data_path": "data/btc_jpy_real_dataset.csv",
      "validation_split": 0.2,
      "test_split": 0.1
    },
    "total_timesteps": 25000,
    "sac_hyperparameters": {
      "learning_rate": 3e-4,
      "batch_size": 256,
      "buffer_size": 100000,
      "learning_starts": 1000,
      "tau": 0.005,
      "gamma": 0.99,
      "ent_coef": "auto_1.0",
      "target_entropy": "auto"
    },
    "environment": {
      "initial_balance": 10000,
      "transaction_cost": 0.0,
      "max_position_size": 1.0,
      "random_start": true,
      "use_continuous_actions": true,
      "feature_engineering": {
        "enabled": true,
        "adaptive_selection": true,
        "correlation_reduction": true,
        "correlation_threshold": 0.85,
        "max_features": 100
      },
      "market_regime_detection": {
        "enabled": true,
        "regime_window": 50,
        "trend_threshold": 0.02,
        "volatility_threshold": 0.15
      },
      "risk_management": {
        "dynamic_position_sizing": true,
        "max_drawdown_limit": 0.1
      },
      "multi_timeframe_integration": {
        "enabled": true,
        "timeframes": ["1H", "4H", "1D"],
        "correlation_threshold": 0.7
      },
      "reward_settings": {
        "base_action_penalty": 0.015,
        "action_bonuses": {
          "buy_action_bonus": 0.0,
          "sell_action_bonus": 0.0,
          "hold_action_bonus": 0.01
        },
        "balance_penalty": 1.0,
        "consistency_penalty": 0.05
      }
    }
  },

  "features": {
    "feature_set": "v443_enhanced",
    "target_dimensions": 150,
    "include_regime_indicators": true,
    "include_volatility_features": true,
    "include_momentum_features": true,
    "include_volume_features": true,
    "include_trend_features": true,
    "include_bearish_signal_features": true,
    "sell_bias_mitigation": {
      "enabled": true,
      "bearish_signal_weight": 1.2,
      "divergence_sensitivity": 0.8,
      "pattern_recognition_threshold": 0.7
    },
    "enhanced_features": {
      "enabled": true,
      "feature_engineering": {
        "regime_features": true,
        "correlation_features": true,
        "ensemble_features": true,
        "risk_features": true,
        "momentum_features": true,
        "volatility_features": true,
        "volume_features": true,
        "trend_features": true,
        "bearish_signal_features": true,
        "sell_signal_oscillators": true,
        "bearish_volume_features": true
      }
    }
  },

  "validation": {
    "enabled": true,
    "validation_interval": 1000,
    "early_stopping": {
      "enabled": true,
      "patience": 10,
      "min_delta": 0.001
    }
  },

  "logging": {
    "level": "INFO",
    "file_logging": true,
    "tensorboard": true,
    "log_dir": "logs/sac_v444.2_10k_test"
  },

  "checkpoint": {
    "enabled": true,
    "save_interval": 1000,
    "save_best": true,
    "max_checkpoints": 5
  }
}
