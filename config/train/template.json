{
  "comment": "設定ファイルテンプレート - コピーして使用してください",
  "_usage": "このテンプレートをコピーし、YOUR_SESSION_ID等を置換してください",
  
  "algorithm": "ppo",
  "data_path": "ml-dataset-enhanced.csv",
  "session_id": "YOUR_SESSION_ID",
  "total_timesteps": 100000,
  
  "training": {
    "learning_rate": 3.0e-4,
    "n_steps": 2048,
    "batch_size": 64,
    "n_epochs": 10,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_range": 0.2,
    "ent_coef": 0.7,
    "ent_coef_schedule": "cosine_decay",
    "ent_coef_final": 0.2,
    "vf_coef": 0.5,
    "max_grad_norm": 0.5,
    "seed": 42
  },
  
  "custom_ppo": {
    "enable_pan": true,
    "enable_target_entropy": true,
    "enable_stratified_sampling": false,
    "target_entropy_ratio": 0.7,
    "lr_temperature": 3.0e-4,
    "initial_temperature": 0.01,
    "pan_epsilon": 1.0e-8
  },
  
  "environment": {
    "transaction_cost": 0.001,
    "max_position_size": 1.0,
    "curriculum_stage": "full",
    "allow_reverse": false
  },
  
  "reward_profit_bonus_multipliers": [1.0, 1.0, 1.0],
  "reward_settings": {
    "enable_forced_diversity": false
  },
  
  "checkpoint_interval": 10000,
  "checkpoint_dir": "checkpoints/YOUR_SESSION_ID",
  "log_dir": "logs/YOUR_SESSION_ID",
  "model_dir": "models/YOUR_SESSION_ID",
  
  "evaluation": {
    "enabled": true,
    "eval_freq": 10000,
    "n_eval_episodes": 10,
    "eval_deterministic": true
  },
  
  "enable_grad_probe_guard": false,
  "grad_probe_config": {
    "zero_threshold": 1e-8,
    "consecutive_zeros": 5,
    "check_interval": 1000,
    "monitor_actions": ["SELL", "BUY", "HOLD"],
    "critical_actions": ["SELL"],
    "save_replay_buffer": true,
    "save_model_state": true,
    "save_diagnostics": true,
    "archive_dir": "grad_probe_archives",
    "save_tensorboard_events": true,
    "save_environment_state": true
  }
}
