{
  "version": "4.4.7-v447.1",
  "training": {
    "model_name": "sac_v447_1m_multiframe_balance_aggressive",
    "algorithm": "sac",
    "total_timesteps": 2000,
    "eval_freq": 1000,
    "checkpoint_interval": 1000,
    "data_config": {
      "use_real_data": true,
      "data_path": "data/btc_jpy_1m_dataset.csv",
      "validation_split": 0.2
    },
    "environment": {
      "timeframe": "1m",
      "initial_balance": 200000.0,
      "transaction_cost": 0.001,
      "max_position_size": 1.0,
      "enable_action_masking": true,
      "use_continuous_actions": true,
      "curriculum_stage": "forced_balance",
      "reward_settings": {
        "use_simple_reward": false,
        "reward_scale": 1.2,
        "trading_bonus": 0.01,
        "profit_bonuses": {
          "small_profit": 0.002,
          "medium_profit": 0.01,
          "large_profit": 0.02
        },
        "penalty_coefficients": {
          "loss_penalty": -0.002,
          "large_loss_penalty": -0.01,
          "inactivity_penalty": -0.0001
        },
        "asymmetric_reward_scaling": {
          "long_position_reward_multiplier": 1.30,
          "short_position_reward_multiplier": 0.88,
          "long_position_penalty_multiplier": 0.95,
          "short_position_penalty_multiplier": 1.05
        },
        "profit_bonus_multiplier_buy": 1.20,
        "profit_bonus_multiplier_sell": 0.85,
        "balance_penalty_enabled": true,
        "balance_penalty_min_actions": 5,
        "balance_penalty_targets": {
          "buy_target": 0.45,
          "sell_target": 0.275,
          "hold_target": 0.275
        },
        "entropy_bonus": 0.04,
        "signal_guidance": {
          "guidance_level": "partial",
          "signal_bonus_weight": 0.12,
          "signal_penalty_weight": 0.02,
          "enable_advanced_integration": true
        }
      },
      "behavior_optimization": {
        "action_balance_target": 0.45,
        "balance_penalty": 2.5,
        "balance_penalty_tolerance": 0.08,
        "entropy_regularization": 0.04,
        "action_smoothing": 0.04,
        "consistency_penalty": 0.02
      },
      "action_bonuses": {
        "buy_action_bonus": 0.05,
        "sell_action_bonus": 0.00,
        "hold_action_bonus": 0.00
      },
      "enable_multi_timeframe": true,
      "multi_timeframe": {
        "base_timeframe": "1min",
        "enabled_timeframes": ["1min", "5min"],
        "feature_weights": {"1min": 0.5, "5min": 0.5}
      }
    },
    "features": {
      "feature_set": "full"
      ,
      "quality_thresholds": {
        "min_variance": 1e-12,
        "max_outlier_rate": 0.4,
        "max_zero_rate": 0.95
      }
    },
    "sac_hyperparameters": {
      "learning_rate": 0.0001,
      "buffer_size": 50000,
      "learning_starts": 100,
      "batch_size": 256,
      "tau": 0.005,
      "gamma": 0.99,
      "ent_coef": 0.02
    }
  },
  "logging": {
    "log_level": "WARNING"
  }
}