{
  "model_name": "sac_v435_2",
  "version": "4.3.5.2",
  "description": "SAC v435.2 - Aggressive Risk Management Variant",

  "training": {
    "total_timesteps": 1000000,
    "learning_rate": 5e-4,
    "batch_size": 512,
    "buffer_size": 2000000,
    "learning_starts": 500,
    "tau": 0.01,
    "gamma": 0.98,
    "ent_coef": "auto_2.0",
    "target_entropy": "auto",
    "curriculum_learning": true
  },

  "environment": {
    "transaction_cost": 0.001,
    "max_position_size": 0.2,
    "random_start": true,
    "enable_correlation_reduction": false,
    "correlation_threshold": 0.7,
    "max_features": 150,
    "feature_adaptation": true,
    "market_regime_detection": true
  },

  "reward_function": {
    "base_profit_bonus_atr_coeff": 8.0,
    "base_profit_bonus_portfolio_coeff": 15.0,
    "base_action_penalty": 0.1,
    "loss_penalty_coeff": -0.5,
    "action_frequency_penalty": 0.02,
    "long_short_asymmetry": true,
    "risk_adjusted_bonus": true,
    "market_regime_penalty": false
  },

  "features": {
    "technical_indicators": [
      "rsi_14", "macd", "macd_signal", "macd_hist",
      "bb_upper", "bb_middle", "bb_lower", "bb_width",
      "stoch_k", "stoch_d", "williams_r",
      "ichimoku_tenkan", "ichimoku_kijun", "ichimoku_senkou_a", "ichimoku_senkou_b",
      "atr_14", "cci_14", "mfi_14", "roc_12", "mom_10",
      "trix", "ultimate_oscillator", "adx", "dmi_plus", "dmi_minus"
    ],
    "price_features": [
      "price_change", "volume_change", "returns", "log_returns",
      "sma_5", "sma_10", "sma_20", "sma_50", "sma_100",
      "volatility_5d", "volatility_10d", "volatility_20d", "volatility_30d"
    ],
    "adaptive_selection": true,
    "correlation_filtering": false,
    "importance_weighting": true
  },

  "risk_management": {
    "dynamic_position_sizing": true,
    "drawdown_control": true,
    "max_drawdown_limit": 0.15,
    "volatility_adjustment": true,
    "correlation_risk": false,
    "aggressive_mode": true
  },

  "data": {
    "primary_dataset": "data/btc_jpy_featured_dataset.csv",
    "validation_split": 0.15,
    "test_split": 0.15,
    "feature_engineering": true,
    "data_augmentation": true
  },

  "evaluation": {
    "backtest_episodes": 200,
    "performance_metrics": [
      "total_return", "win_rate", "max_drawdown",
      "sharpe_ratio", "sortino_ratio", "calmar_ratio",
      "profit_factor", "recovery_factor"
    ],
    "comparison_models": ["v430", "v434.2", "v435", "v435_1"],
    "robustness_tests": true
  },

  "output": {
    "model_dir": "models/v435_2",
    "config_dir": "config/v435",
    "results_dir": "results/v435_2",
    "tensorboard_log": "tensorboard/v435_2"
  }
}
