{
    "model_name": "sac_v413_ultra_profit",
  "algorithm": "sac",
  "total_timesteps": 50000,
  "data_source": "csv",
  "data_path": "btc_jpy_real_dataset.csv",
  "data_config": {
    "csv_path": "btc_jpy_real_dataset.csv",
    "use_real_data": true
  },
  "sac_hyperparameters": {
    "learning_rate": 0.0003,
    "buffer_size": 20000,
    "learning_starts": 500,
    "batch_size": 128,
    "tau": 0.005,
    "gamma": 0.99,
    "train_freq": 1,
    "gradient_steps": 1,
    "ent_coef": 0.01,
    "target_update_interval": 1,
    "target_entropy": -1.0
  },
  "environment": {
    "initial_balance": 200000,
    "transaction_cost": 0.00001,
    "max_position_size": 1.0,
    "enable_action_masking": false,
    "use_continuous_actions": true,
    "use_standardized_observations": true,
    "random_start": true,
    "curriculum_stage": "ultra_profit"
  },
  "reward_settings": {
    "use_simple_reward": false,
    "reward_scale": 500.0,
    "reward_clip_min": -200.0,
    "reward_clip_max": 200.0,
    "forced_balance_scaling": 1.0,
    "enable_inactivity_penalty": true,
    "inactivity_penalty_rate": 0.005,
    "enable_opportunity_cost": true,
    "opportunity_cost_rate": 0.005,
    "enable_trade_execution_bonus": true,
    "trade_execution_bonus_rate": 2.0,
    "buy_action_penalty": 0.0,
    "sell_action_penalty": 0.0,
    "action_threshold_buy": 0.1,
    "action_threshold_sell": -0.1,
    "trading_focused_scaling": 1.0,
    "hold_penalty_rate": 0.05,
    "trading_bonus_multiplier": 5.0,
    "profit_multiplier": 5.0,
    "loss_penalty_multiplier": 0.5,
    "sell_penalty_rate": 0.01,
    "buy_bonus_rate": 0.05
  },
  "checkpoint_interval": 1000,
  "notes": "SAC v406: Moderate reward scale with balanced curriculum for natural action distribution",
  "fixes_implemented": {
    "fix_1": "Reduced reward scale from 8000 to 100 for subtle learning",
    "fix_2": "Changed curriculum from forced_balance to balanced_transition",
    "fix_3": "Reduced reward clip from [-80,80] to [-10,10]",
    "fix_4": "Maintained entropy coef 0.01 and balanced thresholds",
    "fix_5": "Removed BUY/SELL action penalties for neutral learning"
  }
}