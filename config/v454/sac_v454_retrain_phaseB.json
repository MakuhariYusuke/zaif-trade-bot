{
  "version": "1.0",
  "algorithm": "sac",
  "model_name": "sac_v454_retrain_phaseB_trade_pnl",
  "logging_level": "WARNING",
  "description": "SAC v454 Phase B Retrain: Full autonomy (model-driven entry/exit) with trade-focused PnL reward alignment",
  "checkpoint_dir": "models/checkpoints/v454_retrain_phaseB_trade_pnl",
  "checkpoint_interval": 10000,
  "regime_adaptation": {
    "enabled": true,
    "regime_classifier_config": {
      "regime_scheme": "comprehensive",
      "use_multi_timeframe": true,
      "confidence_threshold": 0.6
    },
    "adaptation_rules": {
      "hyperparameter_adjustment": true,
      "reward_scaling": true,
      "exploration_adjustment": true
    },
    "regime_specific_params": {
      "strong_bull": {
        "ent_coef": 0.01,
        "learning_rate": 0.0003,
        "reward_scale": 1.2
      },
      "strong_bear": {
        "ent_coef": 0.01,
        "learning_rate": 0.0003,
        "reward_scale": 1.2
      },
      "high_volatility_range": {
        "ent_coef": 0.05,
        "learning_rate": 0.0005,
        "reward_scale": 0.8
      },
      "consolidation": {
        "ent_coef": 0.02,
        "learning_rate": 0.0001,
        "reward_scale": 1.5
      }
    },
    "adaptation_frequency": 100,
    "performance_tracking_window": 1000
  },
  "training": {
    "algorithm": "sac",
    "model_name": "sac_v454_retrain_phaseB_trade_pnl",
    "total_timesteps": 200000,
    "checkpoint_dir": "models/training_states/v454_retrain_phaseB_trade_pnl",
    "pretrained_model_path": "models/sac_v454_retrain_phaseA_hybrid_pnl_ckpt_20000.zip",
    "data_config": {
      "csv_path": "data/btc_jpy_1m_v454.csv",
      "data_path": "data/btc_jpy_1m_v454.csv",
      "use_real_data": true,
      "validation_split": 0.2
    },
    "sac_hyperparameters": {
      "learning_rate": 0.0003,
      "buffer_size": 100000,
      "learning_starts": 1000,
      "batch_size": 256,
      "tau": 0.005,
      "gamma": 0.99,
      "ent_coef": "auto",
      "target_update_interval": 1,
      "target_entropy": "auto"
    }
  },
  "features": {
      "feature_set": "high_quality"
    },
    "environment": {
      "feature_set": "high_quality",
      "initial_balance": 1000000.0,
      "commission": 0.001,
      "max_position_size": 1.0,
      "reward_scaling": 1.0,
      "action_space_type": "continuous",
      "use_continuous_actions": true,
      "target_feature_count": 166,
      "curriculum_stage": "advanced_regime_adaptation",
      "continuous_to_discrete_threshold": 0.5,
      "adaptive_threshold_mode": true,
      "threshold_volatility_multiplier": 1.0,
      "risk_management": {
        "min_trade_size": 0.0001,
        "take_profit_pct": 0.0
      },
      "behavior_optimization": {
        "action_balance_target": 0.35,
        "entropy_regularization": 0.01,
        "action_smoothing": 0.1,
        "consistency_penalty": 0.05,
        "balance_penalty": 1.0
      },
      "reward_settings": {
        "reward_clip_min": -200.0,
        "reward_clip_max": 200.0,
        "custom_reward_params": {
          "pnl_mode": "trade",
          "trade_pnl_apply": "always"
        }
      },
      "hybrid_config": {
        "enabled": true,
        "time_filter": {
          "enabled": false,
          "excluded_hours": [
            1,
            14,
            17
          ],
          "multiplier": 0.0
        },
        "volatility_filter": {
          "enabled": true,
          "danger_zone_min": 0.005,
          "danger_zone_max": 0.015,
          "multiplier": 0.0
        },
          "regime_filter": {
          "enabled": true,
          "mode": "soft",
          "force_exit": true,
          "excluded_regimes": [],
          "regime_constraints": {
            "high_volatility_ranging": {
              "action_permission": "restricted",
              "position_multiplier": 1.0,
              "confidence_threshold_modifier": -0.15,
              "entry_action_source": "model",
              "exit_action_source": "model",
              "entry_zscore_threshold": 3.0,
              "stop_loss_pct": 0.01,
              "take_profit_pct": 0.02
            },
            "sell_breakdown": {
              "action_permission": "restricted",
              "position_multiplier": 0.2,
              "confidence_threshold_modifier": 0.2,
              "allowed_entry_actions": [
                "sell"
              ]
            },
            "buy_breakout": {
              "action_permission": "restricted",
              "position_multiplier": 0.2,
              "confidence_threshold_modifier": 0.2,
              "allowed_entry_actions": [
                "buy"
              ]
            },
            "sell_volume_surge": {
              "action_permission": "restricted",
              "position_multiplier": 0.2,
              "confidence_threshold_modifier": 0.2,
              "allowed_entry_actions": [
                "sell"
              ]
            },
            "buy_volume_surge": {
              "action_permission": "restricted",
              "position_multiplier": 0.2,
              "confidence_threshold_modifier": 0.2,
              "allowed_entry_actions": [
                "buy"
              ]
            },
            "extreme_volatility": {
              "action_permission": "deny"
            },
            "strong_bear_trend": {
              "action_permission": "deny"
            }
          }
        },
        "trend_filter": {
          "enabled": false,
          "min_trend_strength": 0.0,
          "multiplier": 1.0
        }
      },
      "advanced_market_regime": {
        "enabled": true,
        "regime_classifier_config": {
          "regime_scheme": "comprehensive",
          "use_multi_timeframe": true,
          "confidence_threshold": 0.6
        }
      }
    }
}
