      "profit_reward_multiplier": 10.0,
      "action_diversity_bonus": 0.1,
      "successful_trade_bonus": 5.0,
      "volatility_adjusted_penalty": true,
      "trend_adjusted_bonus": true,
      "range_market_hold_tolerance": 0.5
