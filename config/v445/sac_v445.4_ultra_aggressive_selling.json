{
  "version": "1.0",
  "algorithm": "sac",
  "model_name": "sac_v445.4_ultra_aggressive_selling",
  "description": "SAC v445.4: Ultra Aggressive Selling - Maximum SELL action incentives with enhanced profit-taking mechanics for extreme bullish market optimization",

  "training": {
    "total_timesteps": 10000,
    "algorithm": "SAC",
    "checkpoint": {
      "enabled": true,
      "interval": 1000,
      "save_path": "checkpoints/sac_v445.4_ultra_aggressive_selling",
      "save_best": true,
      "save_freq": 1000,
      "verbose": 1
    },
    "evaluation": {
      "enabled": true,
      "eval_freq": 1000,
      "n_eval_episodes": 5,
      "deterministic": true,
      "render": false
    },
    "logging": {
      "log_interval": 100,
      "tensorboard_log": "tensorboard/sac_v445.4_ultra_aggressive_selling",
      "verbose": 1
    },
    "sac_hyperparameters": {
      "learning_rate": 0.0003,
      "learning_rate_schedule": {
        "type": "cosine",
        "initial_lr": 0.0003,
        "final_lr": 0.00003,
        "warmup_steps": 5000
      },
      "buffer_size": 1000000,
      "learning_starts": 1000,
      "batch_size": 256,
      "tau": 0.005,
      "gamma": 0.99,
      "train_freq": 1,
      "gradient_steps": 1,
      "target_update_interval": 1,
      "ent_coef": "auto",
      "ent_coef_init": 1.0,
      "target_entropy": "auto"
    },

    "data_config": {
      "data_path": "data/btc_jpy_real_dataset.csv",
      "validation_split": 0.2,
      "test_split": 0.1,
      "use_real_data": true
    },

    "environment": {
      "initial_balance": 10000,
      "transaction_cost": 0.001,
      "max_position_size": 1.0,
      "random_start": true,
      "use_continuous_actions": true,
      "continuous_to_discrete_threshold": 0.3333,
      "continuous_to_discrete_threshold_neg": -0.3333,
      "curriculum_stage": "profit_optimized",

      "feature_engineering": {
        "feature_set": "v435_risk_managed",
        "enabled": true,
        "adaptive_selection": true,
        "correlation_reduction": true,
        "correlation_threshold": 0.85,
        "max_features": 100
      },

      "market_regime_detection": {
        "enabled": true,
        "regime_window": 50,
        "trend_threshold": 0.02,
        "volatility_threshold": 0.15
      },

      "risk_management": {
        "dynamic_position_sizing": true,
        "max_drawdown_limit": 0.1
      },

      "multi_timeframe_integration": {
        "enabled": true,
        "timeframes": ["5m", "15m", "1h", "4h"],
        "weighting_scheme": "adaptive"
      },

      "behavior_optimization": {
        "action_balance_target": 0.3,
        "entropy_regularization": 0.0,
        "action_smoothing": 0.15,
        "consistency_penalty": 0.01,
        "balance_penalty": 0.0
      },

      "reward_settings": {
        "reward_scaling": 100.0,
        "reward_clip_min": -200.0,
        "reward_clip_max": 200.0,
        "use_simple_reward": false,
        "profit_bonuses": {
          "base_profit_atr_coefficient": 1.5,
          "base_profit_portfolio_coefficient": 1.2,
          "profit_multipliers": [2.0, 0.6, 0.4],
          "trading_bonus": 0.01,
          "trading_bonus_multiplier": 4.0
        },
        "action_bonuses": {
          "buy_action_bonus": -0.01,
          "sell_action_bonus": 4.0,
          "hold_action_bonus": 0.01,
          "balance_penalty_scale": 300.0
        },
        "asymmetric_reward_scaling": {
          "long_position_reward_multiplier": 1.5,
          "short_position_reward_multiplier": 0.9,
          "long_position_penalty_multiplier": 0.9,
          "short_position_penalty_multiplier": 0.9
        },
        "profit_optimized": {
          "profit_multiplier": 2.5,
          "loss_penalty_multiplier": 1.5,
          "profit_sell_penalty_rate": 0.0,
          "profit_hold_bonus_rate": 0.0,
          "hold_penalty_rate": 0.1,
          "trading_bonus_multiplier": 3.0,
          "position_size_bonus_rate": 0.05,
          "activity_bonus_rate": 0.02,
          "balance_penalty_tolerance": 0.05,
          "balance_penalty": 8.0
        }
      }
    },

    "advanced_market_regime": {
      "enabled": true,
      "detector_type": "advanced",
      "detection_window": 50,
      "adaptation_frequency": 25,
      "regime_smoothing": 0.3,
      "confidence_threshold": 0.6,

      "regime_specific_params": {
        "bull_market": {
          "sell_bonus_multiplier": 1.5,
          "profit_taking_threshold": 0.02,
          "risk_multiplier": 0.8
        },
        "bear_market": {
          "sell_bonus_multiplier": 1.2,
          "profit_taking_threshold": 0.01,
          "risk_multiplier": 1.2
        },
        "sideways_market": {
          "sell_bonus_multiplier": 1.0,
          "profit_taking_threshold": 0.005,
          "risk_multiplier": 1.0
        }
      }
    }
  }
}
