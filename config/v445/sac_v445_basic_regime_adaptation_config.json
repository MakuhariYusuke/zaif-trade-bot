{
  "version": "1.0",
  "algorithm": "sac",
  "model_name": "sac_v445_basic_regime_adaptation",
  "description": "SAC v445: Basic Regime Adaptation with 4 Market Regimes - Fundamental Market Awareness and Adaptive Strategies",
  "max_features": 22,
  "min_features": 50,

  "advanced_market_regime": {
    "enabled": true,
    "detector_type": "basic",
    "detection_window": 50,
    "adaptation_frequency": 10,
    "regime_smoothing": 0.3,
    "confidence_threshold": 0.6,
    "regime_specific_params": {
      "bull": {
        "ent_coef": 0.015,
        "learning_rate": 0.00025,
        "reward_scale": 1.2,
        "action_balance_target": 0.35,
        "position_size_multiplier": 1.2,
        "risk_multiplier": 1.1
      },
      "bear": {
        "ent_coef": 0.015,
        "learning_rate": 0.00025,
        "reward_scale": 1.2,
        "action_balance_target": 0.35,
        "position_size_multiplier": 0.7,
        "risk_multiplier": 0.9
      },
      "sideways": {
        "ent_coef": 0.025,
        "learning_rate": 0.0003,
        "reward_scale": 0.85,
        "action_balance_target": 0.25,
        "position_size_multiplier": 0.7,
        "risk_multiplier": 0.8
      },
      "volatile": {
        "ent_coef": 0.05,
        "learning_rate": 0.0005,
        "reward_scale": 0.6,
        "action_balance_target": 0.15,
        "position_size_multiplier": 0.4,
        "risk_multiplier": 0.5
      }
    },
    "adaptation_rules": {
      "hyperparameter_adjustment": true,
      "reward_scaling": true,
      "exploration_adjustment": true,
      "feature_adaptation": true,
      "risk_management_adaptation": true,
      "position_sizing_adaptation": true
    },
    "transition_smoothing": {
      "enabled": true,
      "transition_window": 5,
      "smoothing_factor": 0.7
    }
  },

  "training": {
    "algorithm": "sac",
    "total_timesteps": 10000,
    "learning_rate": 0.0003,
    "batch_size": 256,
    "buffer_size": 1000000,
    "learning_starts": 1000,
    "gamma": 0.99,
    "tau": 0.005,
    "ent_coef": 0.02,
    "target_entropy": "auto",
    "gradient_steps": 1,
    "train_freq": 1,
    "n_episodes_rollout": -1,
    "data_config": {
      "data_path": "data/btc_jpy_featured_dataset.csv"
    }
  },

  "sac_hyperparameters": {
    "learning_rate": 0.0003,
    "batch_size": 256,
    "buffer_size": 1000000,
    "learning_starts": 1000,
    "gamma": 0.99,
    "tau": 0.005,
    "ent_coef": 0.02,
    "target_entropy": "auto",
    "gradient_steps": 1,
    "train_freq": 1,
    "n_episodes_rollout": -1
  },

  "environment": {
    "type": "trading",
    "max_episode_steps": 1000,
    "reward_function": "advanced_balance_penalty",
    "use_continuous_actions": true,
    "action_space_type": "continuous",
    "initial_balance": 200000.0,
    "commission": 0.001,
    "max_position_size": 1.0,
    "reward_scaling": 1.0,
    "feature_set": "full",
    "curriculum_stage": "advanced_regime_adaptation",
    "continuous_to_discrete_threshold": 0.2,
    "continuous_to_discrete_threshold_neg": -0.2,
    "observation_space": {
      "include_market_regime": true,
      "regime_features": true,
      "technical_indicators": true,
      "price_patterns": true,
      "volume_analysis": true
    },
    "action_space": {
      "type": "continuous",
      "bounds": [-1.0, 1.0],
      "action_smoothing": true
    },
    "data_pipeline": {
      "use_streaming": false,
      "batch_size": 256,
      "shuffle": true,
      "validation_split": 0.2
    }
  },

  "features": {
    "enabled_features": [
      "price_features",
      "volume_features",
      "technical_indicators",
      "market_regime_features",
      "momentum_features",
      "volatility_features",
      "trend_features",
      "oscillator_features",
      "pattern_features"
    ],
    "feature_engineering": {
      "normalization": "robust",
      "scaling": "standard",
      "outlier_handling": "iqr",
      "missing_value_handling": "interpolation"
    },
    "regime_specific_features": {
      "enabled": true,
      "regime_weighted_features": true,
      "adaptive_feature_selection": true
    }
  },

  "evaluation": {
    "eval_freq": 1000,
    "eval_episodes": 10,
    "deterministic": true,
    "render_mode": null,
    "log_tensorboard": true,
    "save_replay_buffer": false,
    "save_vecnormalize": false
  },

  "logging": {
    "tensorboard": true,
    "wandb": false,
    "log_level": "INFO",
    "save_freq": 10000,
    "verbose": 1,
    "regime_logging": {
      "enabled": true,
      "regime_distribution": true,
      "adaptation_metrics": true,
      "performance_by_regime": true
    }
  },

  "model": {
    "policy": "MlpPolicy",
    "net_arch": {
      "pi": [256, 256, 128],
      "qf": [256, 256, 128],
      "vf": [256, 256, 128]
    },
    "activation_fn": "relu",
    "features_extractor_class": null,
    "features_extractor_kwargs": null,
    "normalize_images": false,
    "share_features_extractor": true
  },

  "optimization": {
    "enable_mixed_precision": false,
    "gradient_clipping": 1.0,
    "weight_decay": 0.00001,
    "optimizer": "adam",
    "scheduler": "cosine",
    "early_stopping": {
      "enabled": true,
      "patience": 10,
      "min_delta": 0.001
    }
  },

  "validation": {
    "cross_validation": false,
    "hyperparameter_tuning": false,
    "backtesting": {
      "enabled": true,
      "test_periods": ["2020-01-01", "2021-01-01", "2022-01-01"],
      "metrics": ["sharpe_ratio", "max_drawdown", "win_rate", "total_return"]
    }
  }
}
