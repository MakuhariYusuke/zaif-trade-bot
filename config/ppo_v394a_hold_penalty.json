      "consecutive_hold_exponential": true,
      "consecutive_hold_threshold": 5,
      "trading_frequency_bonus": 0.15,
      "profit_reward_multiplier": 5.0,
      "action_diversity_bonus": 0.05,
      "successful_trade_bonus": 1.0,
      "volatility_adjusted_penalty": true,
      "trend_adjusted_bonus": true,
      "range_market_hold_tolerance": 0.5
