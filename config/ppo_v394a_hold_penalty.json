{
  "model_name": "ppo_v394a_hold_penalty",
  "model_type": "ppo",
  "total_timesteps": 100000,
  "data_source": "csv",
  "data_path": "btc_jpy_real_dataset.csv",
  "data_config": {
    "csv_path": "btc_jpy_real_dataset.csv",
    "use_real_data": true
  },
  "ppo_hyperparameters": {
    "learning_rate": 0.007503,
    "n_steps": 1024,
    "batch_size": 256,
    "n_epochs": 16,
