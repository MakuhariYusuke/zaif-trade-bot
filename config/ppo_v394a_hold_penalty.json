    "gae_lambda": 0.8,
    "clip_range": 0.1,
    "ent_coef": 0.01,
    "vf_coef": 0.5,
    "max_grad_norm": 5.05
  },
  "lagrange_constraint": {
    "enabled": true,
    "r_target": 0.175,
    "tolerance": 0.042625,
    "eta": 0.062875,
    "eta_min": 0.001,
    "eta_max": 100.0,
