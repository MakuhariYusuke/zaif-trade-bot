{
  "version": "1.0",
  "algorithm": "sac",
  "model_name": "sac_v442_10_further_balance_refinement_trading",
  "training": {
    "total_timesteps": 10000,
    "data_config": {
      "data_path": "data/btc_jpy_featured_dataset.csv",
      "use_real_data": true
    },
    "environment": {
      "initial_balance": 100000.0,
      "transaction_cost": 0.0015,
      "max_position_size": 0.05,
      "enable_action_masking": true,
      "use_continuous_actions": true,
      "continuous_to_discrete_threshold": 0.3333,
      "continuous_to_discrete_threshold_neg": -0.3333,
      "use_standardized_observations": true,
      "random_start": true,
      "curriculum_stage": "stability_optimized",
      "feature_set": "minimal",
      "adaptive_feature_selection": {
        "enabled": false
      },
      "reward_settings": {
        "use_simple_reward": false,
        "reward_scale": 1.0,
        "long_position_reward_multiplier": 1.2,
        "short_position_reward_multiplier": 1.4,
        "long_position_penalty_multiplier": 0.9,
        "short_position_penalty_multiplier": 0.85,
        "bear_market_bonus": 0.15,
        "profit_bonus_multiplier": 1.3,
        "loss_penalty_multiplier": 0.75,
        "stability_bonus": 0.1,
        "regime_adaptation_bonus": 0.05,
        "action_balance_penalty": 0.05,
        "trading_bonus": 0.0,
        "profit_bonuses": {
          "trading_bonus": 0.0,
          "profit_multiplier": 1.0,
          "loss_penalty": -1.0
        },
        "action_penalties": {
          "hold_penalty": 0.0,
          "action_frequency_penalty": 0.0
        },
        "risk_penalties": {
          "volatility_penalty": 0.0,
          "correlation_penalty": 0.0
        }
      },
      "risk_management": {
        "enabled": true,
        "dynamic_position_sizing": false,
        "drawdown_control": true,
        "max_drawdown_limit": 0.05,
        "volatility_adjustment": false,
        "correlation_risk": false,
        "market_adaptation": false
      }
    },
    "features": {
      "features": {
        "close": {"enabled": true},
        "volume": {"enabled": true},
        "returns": {"enabled": true},
        "rsi_14": {"enabled": true},
        "macd": {"enabled": true},
        "macd_signal": {"enabled": true},
        "bb_middle": {"enabled": true},
        "stoch_k": {"enabled": true},
        "stoch_d": {"enabled": true},
        "atr_14": {"enabled": true}
      },
      "feature_set": "basic_technical"
    },
    "sac_hyperparameters": {
      "learning_rate": 0.0001,
      "buffer_size": 50000,
      "learning_starts": 1000,
      "batch_size": 128,
      "tau": 0.005,
      "gamma": 0.99,
      "ent_coef": 0.01,
      "target_update_interval": 1,
      "target_entropy": -2.0
    }
  },
  "behavior_optimization": {
    "action_balance_target": 0.55,
    "entropy_regularization": 0.02,
    "action_smoothing": 0.15,
    "consistency_penalty": 0.02
  },
  "optimizer_features": {
    "max_history": 500,
    "enable_normalization": true,
    "normalization_method": "robust",
    "outlier_threshold": 1.5
  },
  "evaluation": {
    "thresholds": {
      "re_evaluate": 0.05,
      "monitor": 0.01
    },
    "min_samples": 10000,
    "risk_metrics": ["sharpe", "sortino", "max_drawdown"],
    "performance_metrics": ["total_return", "win_rate", "profit_factor"]
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  }
}
