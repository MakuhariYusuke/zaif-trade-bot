{
  "version": "1.0",
  "algorithm": "sac",
  "model_name": "sac_v442_14_zero_entropy_adjusted_consistency_balance_trading",
  "training": {
    "total_timesteps": 10000,
    "algorithm": "SAC",
    "sac_hyperparameters": {
      "learning_rate": 3e-4,
      "buffer_size": 1000000,
      "learning_starts": 100,
      "batch_size": 256,
      "tau": 0.005,
      "gamma": 0.99,
      "train_freq": 1,
      "gradient_steps": 1,
      "ent_coef": "auto",
      "target_update_interval": 1,
      "target_entropy": "auto"
    },
    "environment": {
      "type": "TradingEnvironment",
      "config": {
        "data_path": "data/synthetic_trading_data.csv",
        "initial_balance": 10000,
        "max_position_size": 1.0,
        "transaction_cost": 0.001,
        "slippage": 0.0005,
        "reward_scaling": 1.0,
        "long_multiplier": 1.2,
        "short_multiplier": 1.4,
        "penalty_multiplier": 0.9,
        "reward_penalty_multiplier": 0.85,
        "curriculum_stage": "stability_optimized",
        "use_continuous_actions": true,
        "continuous_to_discrete_threshold": 0.3333,
        "continuous_to_discrete_threshold_neg": -0.3333,
        "use_standardized_observations": true,
        "random_start": true,
        "feature_set": "minimal",
        "adaptive_feature_selection": {
          "enabled": false
        },
        "reward_settings": {
          "use_simple_reward": false,
          "reward_scale": 1.0,
          "long_position_reward_multiplier": 1.2,
          "short_position_reward_multiplier": 1.4,
          "long_position_penalty_multiplier": 0.9,
          "short_position_penalty_multiplier": 0.85
        }
      }
    }
  },
  "features": {
    "type": "V4FeatureExtractor",
    "config": {
      "feature_columns": [
        "close", "volume", "returns", "volatility",
        "rsi", "macd", "bb_upper", "bb_lower",
        "stoch_k", "stoch_d", "williams_r",
        "cci", "mfi", "trix", "kama"
      ],
      "sequence_length": 60,
      "prediction_horizon": 1
    }
  },
  "behavior_optimization": {
    "action_balance_target": 0.5,
    "entropy_regularization": 0.0,
    "action_smoothing": 0.15,
    "consistency_penalty": 0.02
  },
  "evaluation": {
    "eval_freq": 1000,
    "eval_episodes": 5,
    "deterministic": true
  }
}
