{
  "version": "1.1",
  "training": {
    "algorithm": "sac",
    "model_name": "sac_v441_stability_focused_10k",
    "total_timesteps": 100000,
    "data_config": {
      "csv_path": "data/btc_jpy_real_dataset.csv",
      "use_real_data": true,
      "validation_split": 0.2
    },
    "environment": {
      "initial_balance": 200000.0,
      "transaction_cost": 0.001,
      "max_position_size": 1.0,
      "enable_action_masking": true,
      "use_continuous_actions": false,
      "use_standardized_observations": true,
      "random_start": true,
      "curriculum_stage": "stability_optimized",
      "continuous_to_discrete_threshold": 0.08,
      "reward_settings": {
        "long_position_reward_multiplier": 1.4,
        "short_position_reward_multiplier": 1.2,
        "long_position_penalty_multiplier": 0.85,
        "short_position_penalty_multiplier": 0.9,
        "bear_market_bonus": 0.15,
        "profit_bonus_multiplier": 1.3,
        "loss_penalty_multiplier": 0.75,
        "stability_bonus": 0.1,
        "regime_adaptation_bonus": 0.05,
        "action_balance_penalty": 0.02
      }
    },
    "features": {
      "feature_set": "v438_extended",
      "include_regime_indicators": true,
      "include_volatility_features": true,
      "include_momentum_features": true
    }
  },
  "sac_hyperparameters": {
    "learning_rate": 0.00025,
    "buffer_size": 150000,
    "learning_starts": 1500,
    "batch_size": 512,
    "tau": 0.003,
    "gamma": 0.995,
    "ent_coef": "auto_0.01",
    "target_update_interval": 2,
    "target_entropy": "auto",
    "l2_regularization": 0.0001,
    "gradient_clip_norm": 0.5,
    "use_layer_norm": true,
    "dropout_rate": 0.1
  },
  "evaluation": {
    "eval_freq": 2000,
    "n_eval_episodes": 10,
    "save_freq": 5000,
    "deterministic_eval": true,
    "stability_metrics": true,
    "regime_analysis": true,
    "statistical_significance_test": true
  },
  "logging": {
    "log_interval": 500,
    "tensorboard_log": "./tensorboard/sac_v441",
    "checkpoint_freq": 2500,
    "detailed_metrics": true
  },
  "stability_improvements": {
    "ensemble_training": false,
    "regularization_schedule": "increasing",
    "learning_rate_schedule": "cosine_annealing",
    "early_stopping_patience": 10,
    "validation_metric": "stability_score"
  },
  "regime_adaptation": {
    "market_regime_detection": true,
    "regime_specific_rewards": true,
    "adaptive_feature_weights": true,
    "regime_transition_smoothing": 0.3
  },
  "behavior_optimization": {
    "action_balance_target": 0.8,
    "entropy_regularization": 0.01,
    "action_smoothing": 0.1,
    "consistency_penalty": 0.05
  }
}
