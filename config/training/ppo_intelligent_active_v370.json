{
  "algorithm": "ppo",
  "session_id": "ppo_intelligent_active_v370",
  "data_path": "ml-dataset-enhanced-balanced.csv",
  "checkpoint_dir": "checkpoints/ppo_intelligent_active_v370",
  
  "comment_objective": "===== INTELLIGENT ACTIVE TRADING =====",
  "comment_objective_1": "Combines intelligent feature selection (60 features) with active trading incentives",
  "comment_objective_2": "Goals: 1) Use best features, 2) Reduce HOLD rate, 3) Maximize profitability",
  
  "comment_memory": "===== MEMORY OPTIMIZATION =====",
  "data_rows_limit": 500,
  "max_features": 60,
  "comment_max_features": "60 = intelligently selected features (removed 5 harmful + 40 correlated + 3 low-importance)",
  "enable_correlation_reduction": false,
  "comment_correlation": "Disabled because we already removed correlated features intelligently",
  
  "comment_ppo": "===== PPO HYPERPARAMETERS =====",
  "total_timesteps": 30000,
  "learning_rate": 0.0003,
  "n_steps": 512,
  "batch_size": 128,
  "n_epochs": 6,
  "gamma": 0.99,
  "gae_lambda": 0.95,
  "clip_range": 0.2,
  "normalize_advantage": true,
  "ent_coef": 0.02,
  "comment_ent_coef": "Increased to 0.02 to encourage exploration and reduce HOLD bias",
  "vf_coef": 0.5,
  "max_grad_norm": 0.5,
  "use_sde": false,
  "sde_sample_freq": -1,
  "verbose": 1,
  
  "comment_env": "===== ENVIRONMENT PARAMETERS =====",
  "max_position_size": 1.0,
  "initial_balance": 1000000,
  "transaction_cost": 0.0005,
  "comment_transaction_cost": "Halved to 0.0005 to encourage more trades",
  "reward_scaling": 1.0,
  
  "comment_reward": "===== REWARD SHAPING (ACTIVE TRADING) =====",
  "reward_settings": {
    "hold_penalty_enabled": true,
    "hold_penalty_weight": 0.0002,
    "comment_hold_penalty": "Penalty for consecutive HOLD actions to encourage trading",
    
    "profit_reward_multiplier": 1.3,
    "comment_profit_multiplier": "Amplify profitable trades to reinforce good behavior",
    
    "action_diversity_bonus": 0.001,
    "comment_diversity_bonus": "Reward for using different actions (BUY/SELL)",
    
    "trading_frequency_target": 0.50,
    "comment_trading_frequency": "Target 50% trading frequency (BUY+SELL rate)"
  },
  
  "comment_policy": "===== POLICY NETWORK =====",
  "policy_kwargs": {
    "net_arch": {
      "pi": [128, 128],
      "vf": [128, 128]
    },
    "activation_fn": "tanh"
  },
  
  "comment_features": "===== CUSTOM FEATURES =====",
  "custom_ppo_enabled": true,
  "policy_action_network_enabled": true,
  "target_entropy_controller_enabled": true,
  "gradient_probe_guard_enabled": false,
  
  "comment_evaluation": "===== EVALUATION =====",
  "eval_freq": 2048,
  "n_eval_episodes": 3,
  "eval_log_path": "checkpoints/ppo_intelligent_active_v370/eval",
  
  "comment_checkpoint": "===== CHECKPOINTING =====",
  "save_freq": 5000,
  "save_replay_buffer": false,
  
  "comment_misc": "===== MISCELLANEOUS =====",
  "seed": 42,
  "device": "auto",
  "tensorboard_log": "checkpoints/ppo_intelligent_active_v370",
  
  "comment_comparison": "===== COMPARISON EXPERIMENT =====",
  "comment_comparison_1": "This config is part of a 3-way comparison:",
  "comment_comparison_2": "  A) ppo_v367_mem_optimized (40 features, variance-based)",
  "comment_comparison_3": "  B) ppo_intelligent_active_v370 (60 features, intelligent selection)",
  "comment_comparison_4": "  C) ppo_full_features_v370 (110 features, full set)"
}
