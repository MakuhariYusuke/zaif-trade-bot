{
  "session_id": "ppo_reward_v381_hybrid_optimized_30k",
  "algorithm": "ppo",
  "description": "Hybrid Optimized 30k Test: Quick validation version of v381 for rapid testing",
  
  "comment_purpose": "v381の30kステップクイックテスト版 - 動作確認と初期評価用",
  "comment_parent_config": "ppo_reward_v381_hybrid_optimized.json",
  
  "curated_features_list": "curated_features.py::CURATED_FEATURES",
  "enable_feature_filtering": true,
  "feature_filter_mode": "whitelist",
  
  "max_features": null,
  "enable_correlation_reduction": false,
  "data_rows_limit": null,
  
  "ppo": {
    "learning_rate": 0.007503,
    "n_steps": 1024,
    "batch_size": 256,
    "n_epochs": 16,
    "gamma": 0.8475,
    "gae_lambda": 0.8,
    "clip_range": 0.1,
    "clip_range_vf": null,
    "ent_coef": 0.001,
    "vf_coef": 0.1,
    "max_grad_norm": 5.05,
    "use_sde": false,
    "sde_sample_freq": -1,
    "target_kl": 0.001,
    "normalize_advantage": true,
    "verbose": 1,
    "policy_kwargs": {
      "net_arch": [
        {"pi": [128, 128], "vf": [128, 128]}
      ]
    }
  },
  
  "environment": {
    "initial_balance": 10000,
    "transaction_cost": 0.0001,
    "max_position_size": 1.0,
    "enable_action_masking": true,
    "random_start": true,
    "reward_settings": {
      "hold_penalty_weight": 0.035,
      "consecutive_hold_penalty": 0.02,
      "consecutive_hold_exponential": true,
      "consecutive_hold_threshold": 4,
      "trading_frequency_bonus": 0.2,
      "profit_reward_multiplier": 3.5,
      "action_diversity_bonus": 0.07,
      "successful_trade_bonus": 0.7,
      "volatility_adjusted_penalty": true,
      "trend_adjusted_bonus": true,
      "range_market_hold_tolerance": 0.5,
      "hold_opportunity_cost": 0.01
    }
  },
  
  "training": {
    "total_timesteps": 30000,
    "checkpoint_interval": 2000,
    "enable_autohalt": true,
    "eval_freq": 1000,
    "n_eval_episodes": 10,
    "reward_scaling": 0.1,
    "progress_bar": false
  },
  
  "custom_ppo": {
    "enabled": true,
    "use_pan": true,
    "use_target_entropy": true,
    "target_entropy": -0.8,
    "use_gradient_probe_guard": false,
    "pan_epsilon": 1e-8,
    "enable_evaluation_gates": true,
    "gate_thresholds": {
      "variance_threshold": 0.01,
      "distribution_check_enabled": true
    }
  },
  
  "lagrange": {
    "r_target": 0.175,
    "tolerance": 0.042625,
    "eta": 0.062875,
    "lambda_max": 3.875,
    "warmup_steps": 3874
  },
  
  "data_path": "ml-dataset-enhanced-balanced.csv",
  
  "comment_usage": "python run_training.py --config configs/training/ppo_reward_v381_hybrid_optimized_30k.json"
}
