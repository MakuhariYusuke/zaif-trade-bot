{
  "session_id": "ppo_aggressive_trading_v371",
  "algorithm": "ppo",
  "description": "60 features (intelligent) + Ultra-aggressive trading settings to reduce HOLD rate below 45%",

  "comment_experiment": "Aggressive trading experiment: HOLD rate reduction from 63% to <45%",
  "comment_strategy": "10x stronger penalties, 5x entropy, ultra-low transaction cost",
  "comment_target": "HOLD <45%, Reward >0, Active BUY/SELL >55%",

  "max_features": 60,
  "enable_correlation_reduction": false,

  "data_rows_limit": 500,

  "ppo": {
    "learning_rate": 0.0003,
    "n_steps": 512,
    "batch_size": 128,
    "n_epochs": 6,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_range": 0.2,
    "clip_range_vf": null,
    "ent_coef": 0.05,
    "vf_coef": 0.5,
    "max_grad_norm": 0.5,
    "use_sde": false,
    "sde_sample_freq": -1,
    "policy_kwargs": {
      "net_arch": [
        {"pi": [128, 128], "vf": [128, 128]}
      ]
    }
  },

  "environment": {
    "initial_balance": 10000,
    "transaction_cost": 0.0001,
    "max_position_size": 1.0,
    "enable_action_masking": true,
    "reward_settings": {
      "hold_penalty_weight": 0.002,
      "profit_reward_multiplier": 1.5,
      "action_diversity_bonus": 0.01
    }
  },

  "training": {
    "total_timesteps": 5000,
    "checkpoint_interval": 5000,
    "enable_autohalt": true,
    "eval_freq": 2000,
    "n_eval_episodes": 5,
    "reward_scaling": 1.0
  },

  "custom_ppo": {
    "enabled": true,
    "use_pan": true,
    "use_target_entropy": true,
    "use_gradient_probe_guard": false,
    "pan_epsilon": 1e-8,
    "enable_evaluation_gates": true,
    "gate_thresholds": {
      "variance_threshold": 0.01,
      "distribution_check_enabled": true
    }
  },

  "data_path": "ml-dataset-enhanced-balanced.csv",

  "comment_changes": "Changes from v370:",
  "changes": [
    "transaction_cost: 0.0005 → 0.0001 (-80%)",
    "ent_coef: 0.02 → 0.05 (+150%)",
    "hold_penalty_weight: 0.0002 → 0.002 (10x)",
    "profit_reward_multiplier: 1.3 → 1.5 (+15%)",
    "action_diversity_bonus: 0.001 → 0.01 (10x)"
  ],

  "expected_behavior": {
    "hold_rate_target": "<45%",
    "buy_sell_rate_target": ">55%",
    "reward_target": ">0 (positive)",
    "exploration_level": "very high (ent_coef=0.05)"
  }
}
