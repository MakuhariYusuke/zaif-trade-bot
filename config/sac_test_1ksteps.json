{
  "model_name": "sac_test_1ksteps",
  "algorithm": "sac",
  "total_timesteps": 1000,
  "data_source": "csv",
  "data_path": "btc_jpy_real_dataset.csv",
  "data_config": {
    "csv_path": "btc_jpy_real_dataset.csv",
    "use_real_data": true
  },
  "sac_hyperparameters": {
    "learning_rate": 0.0003,
    "buffer_size": 5000,
    "learning_starts": 500,
    "batch_size": 128,
    "tau": 0.005,
    "gamma": 0.99,
    "train_freq": 1,
    "gradient_steps": 1,
    "ent_coef": "auto",
    "target_update_interval": 1,
    "target_entropy": "auto"
  },
  "environment": {
    "initial_balance": 200000.0,
    "transaction_cost": 0.0005,
    "max_position_size": 0.01,
    "enable_action_masking": false,
    "use_continuous_actions": true,
    "use_standardized_observations": true,
    "random_start": true,
    "reward_settings": {
      "use_simple_reward": true,
      "reward_scale": 100.0,
      "reward_clip_min": -1.0,
      "reward_clip_max": 1.0,
      "enable_inactivity_penalty": true,
      "inactivity_penalty_rate": 0.001,
      "enable_opportunity_cost": true,
      "opportunity_cost_rate": 0.0005
    }
  },
  "checkpoint_interval": 500,
  "notes": "Test configuration with 1000 steps for metric collection"
}