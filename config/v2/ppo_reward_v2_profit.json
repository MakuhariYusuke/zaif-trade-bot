{
  "session_id": "ppo_reward_v2_profit",
  "algorithm": "ppo",
  "description": "Reward v2: 利益最大化型 - profit_weight 5x増幅 + 超低コスト",

  "comment_experiment": "Experiment 2: Profit maximization reward structure",
  "comment_strategy": "5x profit_weight + ultra-low transaction_cost + moderate hold_penalty",
  "comment_target": "Reward >200, HOLD <50%, High profit focus",

  "max_features": 60,
  "enable_correlation_reduction": false,

  "data_rows_limit": 500,

  "ppo": {
    "learning_rate": 0.0003,
    "n_steps": 512,
    "batch_size": 128,
    "n_epochs": 6,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_range": 0.2,
    "clip_range_vf": null,
    "ent_coef": 0.05,
    "vf_coef": 0.5,
    "max_grad_norm": 0.5,
    "use_sde": false,
    "sde_sample_freq": -1,
    "policy_kwargs": {
      "net_arch": [
        {"pi": [128, 128], "vf": [128, 128]}
      ]
    }
  },

  "environment": {
    "initial_balance": 10000,
    "transaction_cost": 0.00005,
    "max_position_size": 1.0,
    "enable_action_masking": true,
    "reward_settings": {
      "hold_penalty_weight": 0.003,
      "profit_reward_multiplier": 5.0,
      "loss_penalty_multiplier": 2.0,
      "action_diversity_bonus": 0.01
    }
  },

  "training": {
    "total_timesteps": 5000,
    "checkpoint_interval": 5000,
    "enable_autohalt": true,
    "eval_freq": 2000,
    "n_eval_episodes": 5,
    "reward_scaling": 1.0
  },

  "custom_ppo": {
    "enabled": true,
    "use_pan": true,
    "use_target_entropy": true,
    "use_gradient_probe_guard": false,
    "pan_epsilon": 1e-8,
    "enable_evaluation_gates": true,
    "gate_thresholds": {
      "variance_threshold": 0.01,
      "distribution_check_enabled": true
    }
  },

  "data_path": "ml-dataset-enhanced-balanced.csv",

  "comment_changes": "Key changes from v371:",
  "changes": [
    "transaction_cost: 0.0001 → 0.00005 (-50%)",
    "profit_reward_multiplier: 1.5 → 5.0 (3.3x increase)",
    "loss_penalty_multiplier: NEW 2.0 (penalize bad trades)",
    "hold_penalty_weight: 0.002 → 0.003 (1.5x)"
  ],

  "expected_behavior": {
    "hold_rate_target": "<50%",
    "buy_sell_rate_target": ">50%",
    "reward_target": ">200 (very high)",
    "exploration_level": "very high (ent_coef=0.05)",
    "trade_pattern": "Profit-focused, quality over quantity"
  }
}
