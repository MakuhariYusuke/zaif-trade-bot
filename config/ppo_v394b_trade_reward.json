{
  "model_name": "ppo_v394b_trade_reward",
  "model_type": "ppo",
  "total_timesteps": 100000,
  "data_source": "csv",
  "data_path": "btc_jpy_real_dataset.csv",
  "data_config": {
    "csv_path": "btc_jpy_real_dataset.csv",
    "use_real_data": true
  },
  "ppo_hyperparameters": {
    "learning_rate": 0.007503,
    "n_steps": 1024,
    "batch_size": 256,
    "n_epochs": 16,
    "gamma": 0.8475,
    "gae_lambda": 0.8,
    "clip_range": 0.1,
    "ent_coef": 0.01,
    "vf_coef": 0.5,
    "max_grad_norm": 5.05
