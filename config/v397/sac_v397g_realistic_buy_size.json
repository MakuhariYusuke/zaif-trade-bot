{
  "algorithm": "sac",
  "session_name": "sac_v397g_realistic_buy_size",
  "total_timesteps": 10000,
  "save_interval": 2000,
  "progress_interval": 500,
  "min_checkpoint_interval": 1000,
  "learning_rate": 0.0003,
  "batch_size": 256,
  "buffer_size": 100000,
  "learning_starts": 1000,
  "gamma": 0.99,
  "tau": 0.005,
  "train_freq": 1,
  "gradient_steps": 1,
  "ent_coef": "auto",
  "target_entropy": "auto",
  "use_sde": false,
  "sde_sample_freq": -1,
  "use_sde_at_warmup": false,
  "normalize_observations": true,
  "normalize_rewards": false,
  "clip_rewards": 10.0,
  "environment": {
    "env_type": "heavy",
    "initial_balance": 200000.0,
    "max_position_size": 0.01,
    "transaction_cost_rate": 0.001,
    "slippage_rate": 0.0005,
    "window_size": 30,
    "continuous_to_discrete_threshold": 0.1
  },
  "reward": {
    "reward_scale": 1000.0,
    "clip_rewards": 10.0,
    "trade_execution_bonus_rate": 0.2,
    "trade_execution_position_threshold": 0.005,
    "inactivity_penalty_rate": 0.005,
    "inactivity_hold_threshold": 0.01,
    "opportunity_cost_enabled": false,
    "opportunity_cost_lookback": 0,
    "opportunity_cost_rate": 0.0
  },
  "data_path": "btc_jpy_real_dataset.csv",
  "seed": 42,
  "verbose": 1,
  "use_tensorboard": true,
  "log_level": "info"
}
