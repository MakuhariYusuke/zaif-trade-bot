{
  "version": "v446",
  "algorithm": "sac",
  "model_name": "sac_v446_multitimeframe_shortterm_optimized",
  "description": "SAC v446 Multi-Timeframe Short-Term Optimized Configuration: Enhanced for short-term profitability with CPU optimization and advanced features",
  "training": {
    "total_timesteps": 10000,
    "algorithm": "SAC",
    "sac_hyperparameters": {
      "learning_rate": 0.0003,
      "learning_rate_schedule": {
        "type": "cosine",
        "initial_lr": 0.0003,
        "final_lr": 3e-05,
        "warmup_steps": 5000
      },
      "buffer_size": 1000000,
      "learning_starts": 1000,
      "batch_size": 256,
      "tau": 0.005,
      "gamma": 0.99,
      "train_freq": 1,
      "gradient_steps": 1,
      "target_update_interval": 1,
      "ent_coef": "auto",
      "ent_coef_init": 1.0,
      "target_entropy": "auto"
    },
    "data_config": {
      "data_path": "data/btc_jpy_real_dataset.csv",
      "validation_split": 0.2,
      "test_split": 0.1,
      "use_real_data": true,
      "multitimeframe_mixing": {
        "enabled": true,
        "timeframes": [
          "1m",
          "5m",
          "15m",
          "1h"
        ],
        "mixing_ratio": [
          0.4,
          0.3,
          0.2,
          0.1
        ],
        "synthetic_shortterm_generation": true
      }
    },
    "cpu_optimization": {
      "enabled": true,
      "parallel_processing": {
        "data_loading_workers": 4,
        "feature_computation_workers": 4,
        "batch_processing_workers": 2
      },
      "memory_optimization": {
        "use_ttl_cache": true,
        "cache_size_mb": 256,
        "buffer_compression": true
      },
      "model_optimization": {
        "pruning_enabled": true,
        "pruning_ratio": 0.1,
        "quantization_aware_training": false,
        "gpu_fallback_layer": true
      }
    },
    "checkpoint_management": {
      "enabled": true,
      "auto_save_interval": 1000,
      "save_best_model": true,
      "resume_from_checkpoint": true,
      "checkpoint_validation": true
    },
    "logging_optimization": {
      "structured_logging": true,
      "log_level_control": "dynamic",
      "performance_monitoring": true,
      "memory_tracking": true,
      "step_logging_interval": 100
