  "evaluation": {
    "metrics": [
      "sharpe_ratio",
      "max_drawdown",
      "win_rate",
      "profit_factor",
      "calmar_ratio",
      "sortino_ratio",
      "alpha",
      "beta",
      "shortterm_profitability_index",
      "multitimeframe_consistency_score"
    ],
    "benchmark_comparison": true,
    "regime_performance_analysis": true,
    "risk_adjusted_returns": true,
    "shortterm_performance_focus": true,
    "monte_carlo_simulation": {
      "enabled": true,
      "n_simulations": 1000,
      "confidence_level": 0.95,
      "shortterm_scenario_testing": true
    },
    "walk_forward_analysis": {
      "enabled": true,
      "window_size": 1000,
      "step_size": 500,
      "multitimeframe_validation": true
    },
    "hyperparameter_optimization": {
      "enabled": true,
      "optimizer": "optuna",
      "n_trials": 50,
      "metric_to_optimize": "shortterm_sharpe_ratio"
    }
  },
  "system_optimization": {
    "cpu_cores_utilization": 0.8,
    "memory_limit_mb": 4096,
    "parallel_jobs_limit": 4,
    "gpu_fallback_prepared": true,
    "adaptive_resource_allocation": true
  },
  "environment": {
    "initial_balance": 10000,
    "transaction_cost": 0.001,
    "max_position_size": 1.0,
    "random_start": true,
    "use_continuous_actions": true,
    "continuous_to_discrete_threshold": 0.3333,
    "continuous_to_discrete_threshold_neg": -0.3333,
    "max_action_threshold": 1.0,
    "curriculum_stage": "multitimeframe_shortterm",
    "feature_engineering": {
      "enabled": true,
      "adaptive_selection": true,
      "correlation_reduction": true,
      "correlation_threshold": 0.85,
      "max_features": 120,
      "shortterm_focus": true
