{
  "model_name": "sac_v502_fine_tune_2",
  "algorithm": "sac",
  "total_timesteps": 100000,
  "data_source": "csv",
  "data_path": "data/btc_jpy_real_dataset.csv",
  "data_config": {
    "csv_path": "btc_jpy_real_dataset.csv",
    "use_real_data": true
  },
  "sac_hyperparameters": {
    "learning_rate": 0.0003,
    "buffer_size": 20000,
    "learning_starts": 500,
    "batch_size": 128,
    "tau": 0.005,
    "gamma": 0.99,
    "train_freq": 1,
    "gradient_steps": 1,
    "ent_coef": 0.01,
    "target_update_interval": 1,
    "target_entropy": -1.0
  },
  "environment": {
    "initial_balance": 200000.0,
    "transaction_cost": 1e-05,
    "max_position_size": 1.0,
    "enable_action_masking": false,
    "use_continuous_actions": true,
    "use_standardized_observations": true,
    "random_start": true,
    "curriculum_stage": "profit_optimized",
    "continuous_to_discrete_threshold": 0.1
  },
  "reward_settings": {
    "reward_scale": 500.0,
    "reward_clip_min": -200.0,
    "reward_clip_max": 200.0,
    "profit_bonuses": {
      "base_profit_atr_coefficient": 1.5,
      "base_profit_portfolio_coefficient": 1.2,
      "profit_multipliers": [
        1.2,
        1.0,
        0.8
      ],
      "trading_bonus": 0.01,
      "trading_bonus_multiplier": 4.0
    },
    "action_bonuses": {
      "buy_action_bonus": 0.01,
      "sell_action_bonus": -0.005,
      "hold_action_bonus": 0.0,
      "win_rate_bonus": 0.1,
      "momentum_bonus": 0.05,
      "diversity_bonus": 0.02
    },
    "behavior_penalties": {
      "loss_penalty_multiplier": 3.0,
      "balance_penalty": 3.0,
      "balance_penalty_tolerance": 0.05,
      "action_frequency_penalty": 0.005,
      "inactivity_penalty_rate": 0.0025,
      "opportunity_cost_rate": 0.0025
    },
    "risk_penalties": {
      "volatility_penalty": 0.02,
      "position_penalty_soft_cap": 0.8,
      "constraint_penalty": 1.0
    },
    "flags": {
      "enable_forced_diversity": false,
      "enable_inactivity_penalty": true,
      "enable_opportunity_cost": true,
      "enable_trade_execution_bonus": true
    }
  },
  "checkpoint_interval": 1000,
  "notes": "SAC v502: Fine-tuned for balanced ratios - slight buy preference",
  "fixes_implemented": {
    "tune_1": "Increased buy profit multiplier to 1.2, reduced sell to 0.8",
    "tune_2": "Added small buy bonus (0.01), slight sell penalty (-0.005)",
    "tune_3": "Hold remains neutral"
  }
}