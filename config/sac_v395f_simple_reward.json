{
  "model_name": "sac_v395f_simple_reward",
  "algorithm": "sac",
  "total_timesteps": 5000,
  "data_source": "csv",
  "data_path": "btc_jpy_real_dataset.csv",
  "data_config": {
    "csv_path": "btc_jpy_real_dataset.csv",
    "use_real_data": true
  },
  "sac_hyperparameters": {
    "learning_rate": 0.0003,
    "buffer_size": 20000,
    "learning_starts": 500,
    "batch_size": 128,
    "tau": 0.005,
    "gamma": 0.99,
    "train_freq": 1,
    "gradient_steps": 1,
    "ent_coef": "auto",
    "target_update_interval": 1,
    "target_entropy": "auto"
  },
  "environment": {
    "initial_balance": 200000.0,
    "transaction_cost": 0.0005,
    "max_position_size": 0.01,
    "enable_action_masking": false,
    "use_continuous_actions": true,
    "random_start": true,
    "reward_settings": {
      "use_simple_reward": true,
      "reward_scale": 1000.0,
      "reward_clip_min": -10.0,
      "reward_clip_max": 10.0,
      "enable_inactivity_penalty": false,
      "inactivity_penalty": 0.01
    }
  },
  "checkpoint_interval": 1000,
  "notes": "SAC v395f: Revolutionary simple reward function - PnL only",
  "reward_redesign": {
    "motivation": "Complex reward function caused unstable learning (Critic Loss 1e8-1e10, ent_coef 3-4)",
    "solution": "Pure PnL-based reward: reward = (pnl / portfolio_value) * 1000, clipped to [-10, 10]",
    "key_changes": [
      "Removed all action penalties (HOLD, BUY, SELL)",
      "Removed position penalties",
      "Removed diversity bonuses",
      "Removed curriculum stages",
      "Removed trend multipliers",
      "Focus purely on profit/loss"
    ],
    "expected_improvements": {
      "critic_loss": "< 1e6 (was 1e8-1e10)",
      "ent_coef": "0.5-2.0 stable (was 3-4)",
      "hold_ratio": "60-70% (natural, not forced)",
      "learning_speed": "Much faster convergence"
    },
    "reward_formula": "reward = clip((pnl / portfolio_value) * 1000, -10, 10)",
    "reward_interpretation": {
      "0.1% profit": "reward = 1.0",
      "0.5% profit": "reward = 5.0",
      "1.0% profit": "reward = 10.0 (clipped)",
      "0.1% loss": "reward = -1.0",
      "1.0% loss": "reward = -10.0 (clipped)"
    }
  }
}
