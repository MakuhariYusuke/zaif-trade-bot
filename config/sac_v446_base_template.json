{
  "version": "v446",
  "algorithm": "sac",
      "model_name": "sac_v446_5m_100k_config",
  "description": "SAC v446 Base Configuration for Learning Parameter Optimization",

  "training": {
    "total_timesteps": 100000,
    "algorithm": "SAC",
    "sac_hyperparameters": {
      "learning_rate": 0.0003,
      "buffer_size": 1000000,
      "learning_starts": 1000,
      "batch_size": 256,
      "tau": 0.005,
      "gamma": 0.99,
      "train_freq": 1,
      "gradient_steps": 1,
      "target_update_interval": 1,
      "ent_coef": "auto",
      "ent_coef_init": 1.0,
      "target_entropy": "auto"
    },

    "data_config": {
      "data_path": "data/btc_jpy_5m_dataset.csv",
      "validation_split": 0.2,
      "test_split": 0.1,
      "use_real_data": true
    },

    "environment": {
      "initial_balance": 10000,
      "transaction_cost": 0.001,
      "max_position_size": 1.0,
      "random_start": true,
      "use_continuous_actions": true,
      "continuous_to_discrete_threshold": 0.3333,
      "base_threshold": 0.02,
      "max_action_threshold": 1.0,
      "reward_function": "sharpe_ratio_focused",
      "risk_management": {
        "max_drawdown_limit": 0.1,
        "position_sizing": "kelly_criterion",
        "stop_loss_enabled": true,
        "take_profit_enabled": true
      }
    },

    "features": {
      "feature_set": "default",
      "technical_indicators": true,
      "price_patterns": true,
      "volume_analysis": true,
      "market_regime_detection": true,
      "correlation_features": false,
      "dimensionality_reduction": "auto"
    },

    "validation": {
      "enabled": true,
      "validation_freq": 1000,
      "n_eval_episodes": 5,
      "deterministic_eval": true,
      "eval_callback_enabled": true
    },

    "logging": {
      "log_interval": 100,
      "save_freq": 1000,
      "verbose": 1,
      "tensorboard_log": "./tensorboard/sac_v446_optimization",
      "checkpoint_freq": 25000
    },

    "optimization": {
      "early_stopping": {
        "enabled": false,
        "patience": 10,
        "min_delta": 0.001
      },
      "gradient_clipping": {
        "enabled": true,
        "clip_value": 1.0
      }
    }
  },

  "evaluation": {
    "backtest_config": {
      "initial_balance": 10000,
      "transaction_cost": 0.001,
      "max_position_size": 1.0,
      "use_real_data": true,
      "data_path": "data/btc_jpy_real_dataset.csv"
    },
    "metrics": [
      "total_return",
      "sharpe_ratio",
      "max_drawdown",
      "win_rate",
      "profit_factor",
      "calmar_ratio"
    ]
  }
}
