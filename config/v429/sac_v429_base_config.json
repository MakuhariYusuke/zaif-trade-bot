{
  "version": "v429",
  "description": "SAC v429: Advanced Action Balance & Optimization Framework",

  "training": {
    "total_timesteps": 100000,
    "learning_rate": 0.0003,
    "gamma": 0.99,
    "tau": 0.005,
    "ent_coef": "auto_0.01",
    "target_entropy": "auto",
    "batch_size": 256,
    "buffer_size": 1000000,
    "learning_starts": 1000,
    "gradient_steps": 1,
    "train_freq": [1, "step"],
    "action_noise": null
  },

  "reward_function": {
    "reward_scale": 100.0,
    "trading_bonus": 0.01,
    "sell_penalty": 0.0,
    "buy_bonus": 0.0,
    "action_balance_weight": 0.1,
    "hold_penalty": 0.001,
    "profit_focus": true,
    "risk_penalty": 0.1
  },

  "action_conversion": {
    "symmetric_thresholds": true,
    "action_threshold": 0.3333,
    "buy_threshold": 0.3333,
    "sell_threshold": -0.3333,
    "hold_range": [-0.3333, 0.3333]
  },

  "optimization": {
    "bayesian_trials": 100,
    "cross_validation_folds": 5,
    "early_stopping_patience": 20,
    "multi_objective": true,
    "objectives": ["sell_ratio", "sharpe_ratio", "max_drawdown"],
    "constraints": {
      "sell_ratio_max": 0.4,
      "sharpe_ratio_min": 1.5
    }
  },

  "evaluation": {
    "backtest_years": 2,
    "regime_analysis": true,
    "stress_testing": true,
    "performance_metrics": [
      "total_return",
      "sharpe_ratio",
      "max_drawdown",
      "win_rate",
      "profit_factor",
      "action_distribution"
    ]
  },

  "data": {
    "source": "historical",
    "timeframe": "1h",
    "start_date": "2021-01-01",
    "end_date": "2023-12-31",
    "validation_split": 0.2,
    "features": [
      "close", "volume", "returns", "volatility",
      "rsi", "macd", "bollinger", "momentum"
    ]
  },

  "logging": {
    "tensorboard": true,
    "wandb": false,
    "log_level": "INFO",
    "save_freq": 10000,
    "eval_freq": 5000
  }
}
