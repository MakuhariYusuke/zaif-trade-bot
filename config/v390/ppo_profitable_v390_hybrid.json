    },
    "v379_dynamic": {
      "initial_balance": 10000,
      "max_position_size": 1.0,
      "hold_rate": "47.1%",
      "market_adaptation": "volatility/trend-adjusted",
      "strength": "市場適応性"
    },
    "v390_hybrid": {
      "initial_balance": 200000,
      "max_position_size": 0.01,
      "target_hold_rate": "40-50%",
      "profit_multiplier": 5.0,
      "expected_return": "> 0.5%",
