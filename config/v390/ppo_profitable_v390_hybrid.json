{
  "session_id": "ppo_profitable_v390_hybrid",
  "algorithm": "ppo",
  "description": "Profitable Model Hunt v1: v378 stability + v379 aggressiveness + Bitcoin 18M円対応 + スキーマ保存",

  "comment_experiment": "v390: v378/v379の成功要因を活かし、収益性のあるモデルを作成",
  "comment_strategy": "v378の安定性（HOLD 47%）+ v379の市場適応 + Bitcoin 18M円対応設定",
  "comment_target": "Return > 0.5%, 安定性重視、スキーマ自動保存",

  "comment_improvements": [
    "✅ v378: 安定したアクション分布（HOLD 47%, BUY 27%, SELL 26%）",
    "✅ v379: 市場適応型報酬（volatility/trend-adjusted）",
    "✅ Bitcoin 18M円対応: initial_balance 200,000円、max_position_size 0.01 BTC",
    "✅ スキーマ自動保存: UnifiedTrainerが訓練時設定を保存",
    "✅ 収益性重視: profit_reward_multiplier 強化"
  ],

  "curated_features_list": "curated_features.py::CURATED_FEATURES",
  "enable_feature_filtering": true,
  "feature_filter_mode": "whitelist",

  "max_features": null,
  "enable_correlation_reduction": false,

  "data_rows_limit": null,

  "ppo": {
    "learning_rate": 0.0003,
    "n_steps": 512,
    "batch_size": 128,
    "n_epochs": 6,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_range": 0.2,
    "clip_range_vf": null,
    "ent_coef": 0.06,
    "vf_coef": 0.5,
    "max_grad_norm": 0.5,
    "use_sde": false,
    "sde_sample_freq": -1,
    "target_kl": 0.03,
    "policy_kwargs": {
      "net_arch": [
        {"pi": [128, 128], "vf": [128, 128]}
      ]
    }
  },

  "environment": {
    "initial_balance": 200000,
    "transaction_cost": 0.0005,
    "max_position_size": 0.01,
    "enable_action_masking": true,
    "random_start": true,
    "reward_settings": {
      "hold_penalty_weight": 0.02,
      "consecutive_hold_penalty": 0.01,
      "consecutive_hold_exponential": true,
      "consecutive_hold_threshold": 5,
      "trading_frequency_bonus": 0.15,
      "profit_reward_multiplier": 5.0,
      "action_diversity_bonus": 0.05,
      "successful_trade_bonus": 1.0,
      "volatility_adjusted_penalty": true,
      "trend_adjusted_bonus": true,
      "range_market_hold_tolerance": 0.5
    }
  },

  "training": {
    "total_timesteps": 100000,
    "checkpoint_interval": 10000,
    "enable_autohalt": true,
    "eval_freq": 5000,
    "n_eval_episodes": 10,
    "reward_scaling": 1.0
  },

  "custom_ppo": {
    "enabled": true,
    "use_pan": true,
    "use_target_entropy": true,
    "target_entropy": -0.8,
    "use_gradient_probe_guard": false,
    "pan_epsilon": 1e-8,
    "enable_evaluation_gates": true,
    "gate_thresholds": {
      "variance_threshold": 0.01,
      "distribution_check_enabled": true
    }
  },

  "data_path": "ml-dataset-enhanced.csv",

  "comment_comparison": "v378/v379の成功要因を統合:",
  "comparison": {
    "v378_scale": {
      "initial_balance": 10000,
      "max_position_size": 1.0,
      "hold_rate": "47.3%",
      "reward": "-412",
