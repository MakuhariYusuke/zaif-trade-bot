{
  "version": "1.0",
  "training": {
    "model_name": "sac_v435.6",
    "algorithm": "sac",
    "total_timesteps": 100000,
    "data_config": {
      "csv_path": null,
      "use_real_data": true,
      "data_path": "data/btc_jpy_real_dataset.csv",
      "random_start": true,
      "min_samples": 10000
    },
    "environment": {
      "initial_balance": 200000.0,
      "transaction_cost": 1.0e-05,
      "max_position_size": 1.0,
      "enable_action_masking": true,
      "use_continuous_actions": true,
      "use_standardized_observations": true,
      "curriculum_stage": "profit_optimized",
      "continuous_to_discrete_threshold": 0.1,
      "reward_settings": {
        "use_simple_reward": false,
        "reward_scale": 1.0,
        "base_action_reward": 0.01,
        "performance_multiplier": 1.0,
        "balance_penalty_multiplier": 0.1,
        "position_size_penalty": 0.05,
        "volatility_penalty": 0.02,
        "trading_bonus": 0.0,
        "hold_penalty_rate": 0.1,
        "profit_bonuses": {
          "small_profit": 0.001,
          "medium_profit": 0.005,
          "large_profit": 0.01
        },
        "penalty_coefficients": {
          "loss_penalty": -0.002,
          "large_loss_penalty": -0.01,
          "inactivity_penalty": -0.0001
        },
        "entropy_bonus": 0.001,
        "signal_guidance": {
          "enabled": false,
          "guidance_mode": "NO_GUIDANCE",
          "signal_weight": 0.0,
          "guidance_decay": 1.0,
          "signal_bonus_weight": 0.0,
          "signal_penalty_weight": 0.01
        }
      }
    },
    "features": {
      "features": {},
      "feature_set": "default",
      "adaptive_feature_selection": {
        "enabled": true,
        "selection_method": "mutual_info",
        "top_k_features": 20,
        "update_frequency": 1000
      }
    },
    "sac_hyperparameters": {
      "learning_rate": 3.0e-04,
      "buffer_size": 1000000,
      "learning_starts": 1000,
      "batch_size": 256,
      "tau": 0.005,
      "gamma": 0.99,
      "ent_coef": 0.2,
      "target_update_interval": 1
    }
  }
}
