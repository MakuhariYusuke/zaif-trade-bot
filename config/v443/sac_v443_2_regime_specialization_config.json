{
  "version": "1.0",
  "algorithm": "ppo",
  "model_name": "ppo_v443_2_regime_specialization",
  "behavior_optimization": {
    "action_balance_target": 0.8,
    "entropy_regularization": 0.01,
    "action_smoothing": 0.1,
    "consistency_penalty": 0.05,
    "balance_penalty": 1.0
  },
  "training": {
    "algorithm": "ppo",
    "model_name": "ppo_v443_2_regime_specialization",
    "total_timesteps": 100000,
    "data_config": {
      "csv_path": "data/btc_jpy_real_dataset.csv",
      "data_path": "data/btc_jpy_real_dataset.csv",
      "use_real_data": true,
      "validation_split": 0.2
    },
    "environment": {
      "config": {
        "initial_balance": 200000.0,
        "commission": 0.001,
        "max_position_size": 1.0,
        "reward_scaling": 1.0,
        "curriculum_stage": "stability_optimized",
        "continuous_to_discrete_threshold": 0.08,
        "behavior_optimization": {
          "action_balance_target": 0.8,
          "entropy_regularization": 0.01,
          "action_smoothing": 0.1,
          "consistency_penalty": 0.05,
          "balance_penalty": 1.0
        },
        "market_regime": {
          "enabled": true,
          "regime_detection_window": 50,
          "regime_smoothing": 0.3,
          "trend_threshold": 0.02,
          "volatility_threshold": 0.015,
          "regime_adaptive_behavior": {
            "trending_market": {
              "action_balance_target": 0.7,
              "entropy_regularization": 0.008,
              "consistency_penalty": 0.03,
              "balance_penalty": 1.2
            },
            "ranging_market": {
              "action_balance_target": 0.9,
              "entropy_regularization": 0.012,
              "consistency_penalty": 0.08,
              "balance_penalty": 0.8
            },
            "volatile_market": {
              "action_balance_target": 0.85,
              "entropy_regularization": 0.015,
              "consistency_penalty": 0.06,
              "balance_penalty": 1.5
            }
          }
        },
        "risk_management": {
          "enabled": true,
          "max_drawdown_limit": 0.15,
          "position_sizing": {
            "volatility_adjusted": true,
            "regime_adjusted": true,
            "base_position_size": 0.5,
            "volatility_multiplier": 0.8,
            "trend_multiplier": 1.2
          },
          "stop_loss": {
            "enabled": true,
            "trailing_stop": true,
            "stop_loss_percentage": 0.05,
            "trailing_stop_distance": 0.03
          }
        }
      }
    },
    "features": {
      "feature_set": "v443_enhanced",
      "include_regime_indicators": true,
      "include_volatility_features": true,
      "include_momentum_features": true,
      "include_volume_features": true,
      "advanced_features": {
        "momentum_indicators": [
          "rsi",
          "macd",
          "stochastic",
          "williams_r"
        ],
        "volatility_indicators": [
          "bollinger_bands",
          "atr",
          "cci"
        ],
        "volume_indicators": [
          "volume_sma",
          "volume_ratio",
          "vwap"
        ],
        "regime_features": [
          "trend_strength",
          "volatility_regime",
          "market_phase"
        ]
      }
    },
    "ppo_hyperparameters": {
      "learning_rate": 0.00025,
      "n_steps": 2048,
      "batch_size": 512,
      "n_epochs": 10,
      "gamma": 0.995,
      "gae_lambda": 0.95,
      "clip_range": 0.2,
      "ent_coef": 0.01,
      "vf_coef": 0.5,
      "max_grad_norm": 0.5,
      "verbose": 1
    }
  }
}
