{
  "algorithm": "sac",
  "model_name": "sac_v440_enhanced_reward",
  "version": "4.4.0",
  "training": {
    "data_config": {
      "data_path": "data/btc_jpy_real_dataset.csv",
      "validation_split": 0.2,
      "test_split": 0.1
    },
    "total_timesteps": 50000,
    "sac_hyperparameters": {
      "learning_rate": 3e-4,
      "batch_size": 256,
      "buffer_size": 1000000,
      "learning_starts": 1000,
      "tau": 0.005,
      "gamma": 0.99,
      "ent_coef": "auto_1.0",
      "target_entropy": "auto"
    },
    "environment": {
      "initial_balance": 10000,
      "transaction_cost": 0.0,
      "max_position_size": 1.0,
      "random_start": true,
      "enable_correlation_reduction": true,
      "correlation_threshold": 0.85,
      "max_features": 100,
      "feature_adaptation": true
    },
    "reward_function": {
      "use_simple_reward": false,
      "reward_scale": 100.0,
      "trading_bonus": 0.01,
      "profit_bonuses": {
        "enabled": true,
        "thresholds": [0.001, 0.005, 0.01],
        "multipliers": [1.0, 1.5, 2.0]
      },
      "frequency_penalty": {
        "enabled": true,
        "threshold": 0.1,
        "penalty": -0.01
      }
    },
    "checkpoint_dir": "models/training_states"
  }
}
