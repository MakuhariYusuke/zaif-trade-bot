{
  "model_name": "sac_v422c_matching",
  "algorithm": "sac",
  "total_timesteps": 200000,
  "data_source": "csv",
  "data_path": "data/btc_jpy_real_dataset.csv",
  "data_config": {
    "csv_path": "btc_jpy_real_dataset.csv",
    "use_real_data": true
  },
  "sac_hyperparameters": {
    "learning_rate": 0.0005,
    "buffer_size": 200000,
    "learning_starts": 100,
    "batch_size": 16,
    "tau": 0.005,
    "gamma": 0.995,
    "train_freq": 1,
    "gradient_steps": 1,
    "ent_coef": "auto",
    "target_update_interval": 1,
    "target_entropy": -2.0
  },
  "environment": {
    "initial_balance": 1000000.0,
    "transaction_cost": 0.001,
    "max_position_size": 0.1,
    "enable_action_masking": false,
    "use_continuous_actions": true,
    "use_standardized_observations": true,
    "random_start": true,
    "curriculum_stage": "matching_networks_optimization",
    "continuous_to_discrete_threshold": 0.05
  },
  "reward_settings": {
    "reward_scale": 1000.0,
    "reward_clip_min": -10.0,
    "reward_clip_max": 10.0,
    "profit_bonuses": {
      "base_profit_atr_coefficient": 1.5,
      "base_profit_portfolio_coefficient": 1.2,
      "profit_multipliers": [2.0, 0.6, 0.4],
      "trading_bonus": 0.01,
      "trading_bonus_multiplier": 4.0
    },
    "action_bonuses": {
      "buy_action_bonus": -0.01,
      "sell_action_bonus": 0.02,
      "hold_action_bonus": 0.01,
      "win_rate_bonus": 0.1,
      "momentum_bonus": 0.05,
      "diversity_bonus": 0.02
    },
    "behavior_penalties": {
      "loss_penalty_multiplier": 3.0,
      "balance_penalty": 3.0,
      "balance_penalty_tolerance": 0.05,
      "action_frequency_penalty": 0.005,
      "inactivity_penalty_rate": 0.00005,
      "opportunity_cost_rate": 0.00005
    },
    "risk_penalties": {
      "volatility_penalty": 0.02,
      "position_penalty_soft_cap": 0.8,
      "constraint_penalty": 1.0
    },
    "flags": {
      "enable_forced_diversity": false,
      "enable_inactivity_penalty": true,
      "enable_opportunity_cost": false,
      "enable_trade_execution_bonus": true
    }
  },
  "fewshot_learning": {
    "enabled": true,
    "method": "matching",
    "n_way": 5,
    "k_shot": 3,
    "query_shots": 5,
    "meta_batch_size": 4,
    "num_episodes_per_epoch": 150,
    "validation_episodes": 75,
    "inner_learning_rate": 0.01,
    "meta_learning_rate": 0.0005,
    "num_inner_steps": 10,
    "distance_metric": "cosine",
    "enable_prototypical": false,
    "enable_matching": true,
    "enable_maml": false,
    "matching_config": {
      "fce": true,
      "lstm_layers": 1,
      "lstm_hidden": 64,
      "attention_layers": 2,
      "attention_heads": 4,
      "dropout": 0.1,
      "full_context_embeddings": true
    }
  },
  "checkpoint_interval": 20000,
  "notes": "SAC v422c: Matching Networks Specialization - Attention-based few-shot learning",
  "fixes_implemented": {
    "feature_1": "Full Context Embeddings (FCE) with LSTM processing",
    "feature_2": "Multi-head attention mechanism for similarity matching",
    "feature_3": "Cosine distance for temporal pattern recognition",
    "feature_4": "Optimized for 3-shot 5-way tasks with sequential data"
  }
}
