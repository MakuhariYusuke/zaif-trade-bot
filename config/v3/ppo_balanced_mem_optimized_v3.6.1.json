{
  "_comment_header": "=== PPO Balanced Memory-Optimized Configuration v3.6.1 ===",
  "_comment_purpose": "Production-ready configuration for balanced action distribution with memory optimization",
  "_comment_version": "Last updated: 2025-10-08 after Bug #44, #45 fixes and magic number elimination",

  "_comment_algorithm": "=== Core Algorithm Settings ===",
  "algorithm": "ppo",
  "session_id": "ppo_balanced_mem_optimized",
  "total_timesteps": 30000,
  "seed": 42,

  "_comment_curriculum": "=== Curriculum Learning ===",
  "_comment_curriculum_detail": "Forced balance stage enforces 33/33/33 HOLD/BUY/SELL distribution to prevent action bias",
  "curriculum_stage": "forced_balance",

  "_comment_lagrange": "=== Lagrange Constraint (SELL Bias Mitigation) ===",
  "_comment_lagrange_detail": "Constrained optimization to maintain target SELL rate of 33%",
  "lagrange_r_target": 0.33,
  "lagrange_tolerance": 0.05,
  "lagrange_eta": 0.05,
  "lagrange_lambda_max": 2.0,
  "lagrange_warmup_steps": 1000,

  "_comment_diversity": "=== Diversity Enforcement ===",
  "_comment_diversity_detail": "Additional mechanisms beyond Lagrange to ensure action diversity",
  "enable_forced_diversity": true,
  "enable_sell_mitigation": true,
  "enable_lagrange": true,
  "enable_probes": true,
  "enable_weights": false,
  "enable_pan": true,
  "enable_target_entropy": false,
  "enable_stratified_sampling": false,

  "_comment_memory": "=== Memory Optimization ===",
  "_comment_memory_detail": "Reduced batch sizes for low-memory environments (n_steps=512, batch_size=32)",
  "n_steps": 512,
  "batch_size": 32,
  "n_epochs": 10,
  "n_envs": 1,

  "_comment_learning": "=== PPO Hyperparameters ===",
  "_comment_learning_detail": "Conservative settings for stable learning",
  "learning_rate": 0.0003,
  "gamma": 0.99,
  "gae_lambda": 0.95,
  "ent_coef": 0.1,
  "vf_coef": 0.5,
  "max_grad_norm": 0.5,
  "clip_range": 0.2,
  "clip_range_vf": null,
  "target_kl": 0.07,
  "normalize_advantage": true,
  "use_sde": false,
  "sde_sample_freq": -1,

  "_comment_network": "=== Policy Network Architecture ===",
  "_comment_network_detail": "Separate networks for policy (pi) and value function (vf) with 2x256 hidden layers",
  "policy_kwargs": {
    "net_arch": [
      {
        "pi": [256, 256],
        "vf": [256, 256]
      }
    ],
    "activation_fn": "Tanh",
    "ortho_init": false
  },

  "_comment_checkpoints": "=== Checkpoint & Model Saving ===",
  "checkpoint_frequency": 5000,
  "checkpoint_interval": 5000,
  "checkpoint_dir": "checkpoints/ppo_balanced_mem_optimized",
  "model_dir": "models",
  "save_model": true,

  "_comment_data": "=== Dataset Configuration ===",
  "data_path": "ml-dataset-enhanced.csv",
  "validation_split": 0.0,

  "_comment_environment": "=== Trading Environment Configuration ===",
  "_comment_environment_detail": "CRITICAL: Must match top-level settings (Bug #45 fix)",
  "env_config": {
    "transaction_cost": 0.001,
    "max_position_size": 0.5,
    "curriculum_stage": "forced_balance",
    "reward_scaling": 6.0,
    "enable_correlation_reduction": false,
    "feature_storage_dtype": "float32",
    "allow_reverse": true
  },

  "_comment_reward": "=== Reward Settings ===",
  "_comment_reward_detail": "Balanced reward structure with profit bonus multipliers",
  "reward_settings": {
    "enable_forced_diversity": true,
    "profit_bonus_multipliers": [1.0, 1.0, 1.0],
    "action_penalty_scale": 0.01,
    "position_soft_cap": 0.8,
    "position_penalty_scale": 0.1,
    "position_penalty_exp": 2.0,
    "inventory_penalty_scale": 0.01,
    "trade_frequency_penalty": 0.01,
    "trade_frequency_halflife": 8.0,
    "trade_cooldown_steps": 2,
    "trade_cooldown_penalty": 0.01,
    "max_consecutive_trades": 10,
    "consecutive_trade_penalty": 0.05,
    "volatility_penalty_scale": 0.01,
    "sharpe_bonus_scale": 0.01,
    "reward_clip_value": 2.0
  },

  "_comment_logging": "=== Logging & Monitoring ===",
  "tensorboard_log": "tensorboard",
  "probe_csv_path": "checkpoints/ppo_balanced_mem_optimized/sell_probe.csv",
  "verbose": 1,
  "offline_mode": false,

  "_comment_top_level": "=== Top-Level Settings (must match env_config - Bug #45) ===",
  "reward_scaling": 6.0,
  "transaction_cost": 0.001,
  "max_position_size": 0.5,
  "allow_reverse": true,

  "_comment_validation": "=== Validation Criteria ===",
  "_comment_validation_detail": "Thresholds for acceptable model behavior",
  "target_sell_rate_min": 0.12,
  "target_sell_rate_optimal": 0.33,
  "grad_norm_threshold": 1e-06,
  "moving_window": 5000,

  "_comment_footer": "=== Configuration Integrity Checksums ===",
  "_config_version": "3.6.1",
  "_last_validated": "2025-10-08",
  "_bugs_fixed": ["Bug #44: Test coverage", "Bug #45: Config inconsistency", "Bug #47: Magic numbers"],
  "_validation_status": "✅ PRODUCTION_READY"
}
