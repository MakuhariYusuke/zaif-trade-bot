{
  "version": "1.0",
  "training": {
    "model_name": "sac_v436_no_guidance",
    "algorithm": "sac",
    "total_timesteps": 5000,
    "data_config": {
      "data_path": "data/btc_jpy_featured_dataset.csv",
      "use_real_data": true
    },
    "environment": {
      "initial_balance": 100000.0,
      "transaction_cost": 0.0015,
      "max_position_size": 0.1,
      "enable_action_masking": true,
      "use_continuous_actions": true,
      "continuous_to_discrete_threshold": 0.3333,
      "continuous_to_discrete_threshold_neg": -0.3333,
      "use_standardized_observations": true,
      "random_start": true,
      "curriculum_stage": "signal_guided_trading",
      "feature_set": "v435_risk_managed",
      "adaptive_feature_selection": {
        "enabled": true,
        "regime_classifier": {
          "adx_threshold": 25.0,
          "volatility_percentile": 70.0
        },
        "attention_layer": {
          "enabled": true,
          "hidden_dim": 128
        },
        "min_weight_threshold": 0.3
      },
      "reward_settings": {
        "use_simple_reward": false,
        "reward_scale": 100.0,
        "trading_bonus": 0.01,
        "profit_bonuses": {
          "trading_bonus": 0.01,
          "profit_multiplier": 2.0,
          "loss_penalty": -2.0
        },
        "action_penalties": {
          "hold_penalty": 0.15,
          "action_frequency_penalty": 0.05
        },
        "risk_penalties": {
          "volatility_penalty": 0.02,
          "correlation_penalty": 0.01
        },
        "signal_guidance": {
          "enabled": false,
          "signal_bonus_weight": 0.0,
          "signal_penalty_weight": 0.0,
          "guidance_mode": "no_guidance",
          "guidance_decay": 1.0
        }
      },
      "risk_management": {
        "enabled": true,
        "dynamic_position_sizing": true,
        "drawdown_control": true,
        "max_drawdown_limit": 0.1,
        "volatility_adjustment": true,
        "correlation_risk": true,
        "market_adaptation": true
      }
    },
    "features": {
      "features": {
        "rsi_14": {"enabled": true},
        "macd": {"enabled": true},
        "macd_signal": {"enabled": true},
        "macd_hist": {"enabled": true},
        "bb_upper": {"enabled": true},
        "bb_middle": {"enabled": true},
        "bb_lower": {"enabled": true},
        "bb_width": {"enabled": true},
        "stoch_k": {"enabled": true},
        "stoch_d": {"enabled": true},
        "williams_r": {"enabled": true},
        "ichimoku_tenkan": {"enabled": true},
        "ichimoku_kijun": {"enabled": true},
        "ichimoku_senkou_a": {"enabled": true},
        "ichimoku_senkou_b": {"enabled": true},
        "atr_14": {"enabled": true},
        "cci_14": {"enabled": true},
        "mfi_14": {"enabled": true},
        "roc_12": {"enabled": true},
        "mom_10": {"enabled": true}
      },
      "feature_set": "v435_risk_managed",
      "adaptive_feature_selection": {
        "enabled": true,
        "regime_classifier": {
          "adx_threshold": 25.0,
          "volatility_percentile": 70.0
        },
        "attention_layer": {
          "enabled": true,
          "hidden_dim": 128
        },
        "min_weight_threshold": 0.3
      }
    },
    "sac": {
      "learning_rate": 3e-4,
      "buffer_size": 1000000,
      "learning_starts": 1000,
      "batch_size": 256,
      "tau": 0.005,
      "gamma": 0.99,
      "train_freq": 1,
      "gradient_steps": 1,
      "target_update_interval": 1,
      "ent_coef": "auto",
      "ent_coef_init": 1.0,
      "use_sde": false,
      "sde_sample_freq": -1,
      "use_sde_at_warmup": false,
      "policy_kwargs": {
        "net_arch": [400, 300],
        "activation_fn": "relu"
      }
    }
  }
}
