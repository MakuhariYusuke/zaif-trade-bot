{
  "version": "4.4.8-v448.full-eval",
  "training": {
    "model_name": "sac_v448_balanced_full_eval",
    "algorithm": "sac",
    "total_timesteps": 10000,
    "eval_freq": 2000,
    "checkpoint_interval": 2000,
    "data_config": {
      "use_real_data": true,
      "data_path": "data/btc_jpy_1m_dataset.csv",
      "validation_split": 0.2
    },
    "environment": {
      "timeframe": "1m",
      "initial_balance": 200000.0,
      "transaction_cost": 0.001,
      "max_position_size": 1.0,
      "enable_action_masking": true,
      "use_continuous_actions": true,
      "curriculum_stage": "balanced_transition",
      "curriculum_learning": {
        "enabled": true,
        "auto_progression": true,
        "emergency_revert": true,
        "stage_conditions": {
          "forced_balance": {
            "min_steps": 100,
            "balance_threshold": 0.15
          },
          "balanced_transition": {
            "min_steps": 200,
            "balance_threshold": 0.2,
            "avg_reward_threshold": 0.0
          },
          "pnl_focused": {
            "min_steps": 500,
            "avg_reward_threshold": 2.0,
            "sharpe_threshold": 0.5
          }
        }
      },
      "reward_settings": {
        "use_simple_reward": false,
        "reward_scale": 1.8,
        "trading_bonus": 0.01,
        "profit_bonuses": {
          "small_profit": 0.001,
          "medium_profit": 0.005,
          "large_profit": 0.01
        },
        "penalty_coefficients": {
          "loss_penalty": -0.002,
          "large_loss_penalty": -0.01,
          "inactivity_penalty": -0.0001
        },
        "asymmetric_reward_scaling": {
          "long_position_reward_multiplier": 1.0,
          "short_position_reward_multiplier": 1.0,
          "long_position_penalty_multiplier": 1.0,
          "short_position_penalty_multiplier": 1.0
        },
        "profit_bonus_multiplier_buy": 1.0,
        "profit_bonus_multiplier_sell": 1.0,
        "entropy_bonus": 0.05,
        "balance_penalty_enabled": true,
        "balance_penalty_min_actions": 50,
        "balance_penalty_targets": {
          "buy_target": 0.475,
          "sell_target": 0.475,
          "hold_target": 0.05
        },
        "balance_penalty": 8.0,
        "balance_penalty_tolerance": 0.04,
        "balance_shaping_enabled": true,
        "balance_shaping_value": 0.08,
        "action_entropy_shaping_enabled": true,
        "action_entropy_shaping_value": 0.02,
        "forced_balance_min_actions": 100,
        "forced_balance_threshold": 0.08,
        "forced_balance_emergency_penalty": 500.0,
        "forced_balance.penalty.scale": 3.0,
        "forced_balance.penalty.value_very_large_deviation": 300.0,
        "forced_balance.bonus.scale": 2.0,
        "forced_balance.bonus.value_large_deviation": 40.0,
        "signal_guidance": {
          "guidance_level": "partial",
          "signal_bonus_weight": 0.05,
          "signal_penalty_weight": 0.03,
          "enable_advanced_integration": true
        }
      },
      "behavior_optimization": {
        "action_balance_target": 0.45,
        "balance_penalty": 8.0,
        "balance_penalty_tolerance": 0.04,
        "entropy_regularization": 0.05,
        "action_smoothing": 0.06,
        "consistency_penalty": 0.03
      },
      "action_bonuses": {
        "buy_action_bonus": 0.0,
        "sell_action_bonus": 0.0,
        "hold_action_bonus": 0.0
      },
      "enable_multi_timeframe": true,
      "multi_timeframe": {
        "base_timeframe": "1min",
        "enabled_timeframes": ["1min", "5min", "15min"],
        "feature_weights": {
          "1min": 0.32,
          "5min": 0.48,
          "15min": 0.2
        }
      }
    },
    "features": {
      "feature_set": "full",
      "custom_features": null,
      "quality_thresholds": {
        "min_variance": 1e-12,
        "max_outlier_rate": 0.4,
        "max_zero_rate": 0.95
      }
    },
    "sac_hyperparameters": {
      "learning_rate": 0.0001,
      "buffer_size": 50000,
      "learning_starts": 100,
      "batch_size": 256,
      "tau": 0.005,
      "gamma": 0.99,
      "ent_coef": 0.05
    }
  },
  "behavior": {
    "mtf": {
      "weight_optimizer": {
        "enabled": true,
        "base_config": "config/v448/templates/mtf_optimizer_template.json",
        "out_dir": "config/v448/mtf_candidates",
        "candidates": 8,
        "per_seed": 3,
        "timesteps": 3000,
        "strategy": "random",
        "seed": 448,
        "gate_min_reports": 3,
        "gate_composite_score": 0.45,
        "stage_filter": ["balanced_transition", "pnl_focused"],
        "dry_run": false
      }
    }
  },
  "logging": {
    "log_level": "WARNING"
  }
}
