class SELLBiasMitigationPPOTrainer(PPOTrainerAutoHalt):
    """
    Extended PPO Trainer with comprehensive SELL bias mitigation.

    This trainer integrates multiple mitigation strategies:
    - Lagrange constraint for minimum SELL rate guarantee
    - Gradient probes for monitoring and failsafe
    - Enhanced action weighting
    - PAN (Per-Action Advantage Normalization)
    - Target Entropy Controller for exploration maintenance
    - Stratified Mini-batch Sampler for minority scenario boosting
    """

    # Mitigation components
    lagrange: Optional[LagrangeConstraint]
    probe: Optional[SELLGradientProbe]
    weight_calc: Optional[ActionWeightCalculator]
    pan_normalizer: Optional[PerActionAdvantageNormalizer]
    entropy_controller: Optional[TargetEntropyController]
    stratified_sampler: Optional[StratifiedSampler]

    # Configuration flags
    enable_lagrange: bool
    enable_probes: bool
    enable_weights: bool
    enable_pan: bool
    enable_target_entropy: bool
    enable_stratified_sampling: bool

    # Paths
    data_path: str
    checkpoint_dir: str

