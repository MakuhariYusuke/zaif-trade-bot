{
  "version": "1.0",
  "description": "SAC v432.0: Advanced Ensemble Learning with Optimized Reward Structure",
  "algorithm": "sac",
  "training": {
    "model_name": "sac_v432_ensemble_optimized",
    "algorithm": "sac",
    "total_timesteps": 120000,
    "learning_rate": 0.0003,
    "batch_size": 256,
    "buffer_size": 1000000,
    "gamma": 0.99,
    "tau": 0.005,
    "ent_coef": "auto",
    "target_update_interval": 1,
    "gradient_steps": 1,
    "learning_starts": 1000,
    "use_sde": true,
    "use_sde_at_warmup": true,
    "sde_sample_freq": 4,
    "policy_kwargs": {
      "net_arch": [400, 300]
    }
  },
  "reward_function": {
    "sell_bonus": 0.3,
    "hold_bonus": 0.005,
    "buy_bonus": 0.3,
    "market_adaptive": {
      "sideways_multiplier": 1.8,
      "high_vol_multiplier": 1.3,
      "low_vol_multiplier": 0.7,
      "bull_multiplier": 1.1,
      "bear_multiplier": 1.1
    },
    "risk_penalty": 0.03,
    "time_penalty": 0.0005,
    "success_bonus": 0.1,
    "failure_penalty": 0.05
  },
  "action_thresholds": {
    "sell_threshold": -0.12,
    "buy_threshold": 0.12,
    "hold_range": [-0.12, 0.12],
    "adaptive_thresholds": true,
    "volatility_adjustment": true
  },
  "advanced_learning": {
    "curriculum": {
      "enabled": true,
      "stages": [
        {
          "name": "exploration",
          "timesteps": 20000,
          "learning_rate": 0.001,
          "focus": "high_entropy_exploration",
          "entropy_coef": "auto_1.0"
        },
        {
          "name": "foundation",
          "timesteps": 30000,
          "learning_rate": 0.0005,
          "focus": "basic_market_patterns",
          "entropy_coef": "auto_0.5"
        },
        {
          "name": "specialization",
          "timesteps": 40000,
          "learning_rate": 0.0002,
          "focus": "market_condition_adaptation",
          "entropy_coef": "auto_0.2"
        },
        {
          "name": "optimization",
          "timesteps": 30000,
          "learning_rate": 0.00005,
          "focus": "precision_optimization",
          "entropy_coef": "auto_0.05"
        }
      ]
    },
    "multi_stage": {
      "enabled": true,
      "stages": [
        {
          "name": "warmup",
          "timesteps": 15000,
          "focus": "exploration",
          "entropy_coef": "auto_1.0"
        },
        {
          "name": "exploitation",
          "timesteps": 35000,
          "focus": "optimal_policy_learning",
          "entropy_coef": "auto_0.1"
        },
        {
          "name": "fine_tuning",
          "timesteps": 20000,
          "focus": "policy_refinement",
          "entropy_coef": "auto_0.01"
        }
      ]
    },
    "ensemble": {
      "enabled": true,
      "members": 5,
      "specializations": ["bull", "bear", "sideways", "high_vol", "low_vol"],
      "voting_mechanism": "weighted_confidence",
      "diversity_weight": 0.4,
      "consensus_requirement": 0.7,
      "member_configs": {
        "bull": {
          "reward_multiplier": {"buy_bonus": 1.2, "sell_bonus": 0.9},
          "action_bias": {"buy_threshold": 0.1, "sell_threshold": -0.2}
        },
        "bear": {
          "reward_multiplier": {"buy_bonus": 0.9, "sell_bonus": 1.2},
          "action_bias": {"buy_threshold": 0.2, "sell_threshold": -0.1}
        },
        "sideways": {
          "reward_multiplier": {"hold_bonus": 2.0},
          "action_bias": {"buy_threshold": 0.15, "sell_threshold": -0.15}
        },
        "high_vol": {
          "reward_multiplier": {"buy_bonus": 1.1, "sell_bonus": 1.1},
          "action_bias": {"buy_threshold": 0.08, "sell_threshold": -0.08}
        },
        "low_vol": {
          "reward_multiplier": {"hold_bonus": 1.5},
          "action_bias": {"buy_threshold": 0.18, "sell_threshold": -0.18}
        }
      }
    },
    "meta_learning": {
      "enabled": true,
      "adaptation_rate": 0.01,
      "task_similarity_threshold": 0.8
    },
    "continual_learning": {
      "enabled": true,
      "memory_size": 10000,
      "replay_ratio": 0.3
    }
  },
  "evaluation": {
    "eval_freq": 5000,
    "n_eval_episodes": 10,
    "deterministic": true,
    "render": false
  },
  "logging": {
    "tensorboard_log": "tensorboard_logs/v432",
    "verbose": 1,
    "log_interval": 100
  }
}
