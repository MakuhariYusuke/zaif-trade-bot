{
  "version": "1.0",
  "description": "SAC v432.1: Advanced Position Management with Negative HOLD Penalty",
  "algorithm": "sac",
  "training": {
    "model_name": "sac_v432_1_advanced_position_management",
    "algorithm": "sac",
    "total_timesteps": 120000,
    "learning_rate": 0.0003,
    "batch_size": 256,
    "buffer_size": 1000000,
    "gamma": 0.99,
    "tau": 0.005,
    "ent_coef": "auto",
    "target_update_interval": 1,
    "gradient_steps": 1,
    "learning_starts": 1000,
    "use_sde": true,
    "use_sde_at_warmup": true,
    "sde_sample_freq": 4,
    "policy_kwargs": {
      "net_arch": [400, 300]
    }
  },
  "reward_function": {
    "sell_bonus": 0.3,
    "hold_bonus": -0.02,
    "buy_bonus": 0.3,
    "market_adaptive": {
      "sideways_multiplier": 2.0,
      "high_vol_multiplier": 1.5,
      "low_vol_multiplier": 0.6,
      "bull_multiplier": 1.2,
      "bear_multiplier": 1.2
    },
    "risk_penalty": 0.03,
    "time_penalty": 0.0005,
    "success_bonus": 0.1,
    "failure_penalty": 0.05
  },
  "action_thresholds": {
    "sell_threshold": -0.08,
    "buy_threshold": 0.08,
    "hold_range": [-0.08, 0.08],
    "adaptive_thresholds": true,
    "volatility_adjustment": true
  },
  "advanced_position_management": {
    "enabled": true,
    "dynamic_sizing": {
      "enabled": true,
      "base_position_size": 0.1,
      "volatility_scaling": {
        "low_vol_max": 0.15,
        "high_vol_min": 0.05,
        "scaling_factor": 0.5
      },
      "confidence_scaling": {
        "high_conf_max": 0.2,
        "low_conf_min": 0.03,
        "scaling_factor": 0.7
      }
    },
    "entry_conditions": {
      "trend_strength_min": 0.025,
      "volume_confirmation": true,
      "momentum_alignment": true,
      "support_resistance_filter": true
    },
    "exit_conditions": {
      "profit_target_pct": 0.05,
      "stop_loss_pct": 0.03,
      "trailing_stop_enabled": true,
      "time_based_exit": {
        "max_hold_periods": 50,
        "force_exit_penalty": 0.05
      }
    },
    "risk_management": {
      "max_position_size": 0.25,
      "max_drawdown_limit": 0.15,
      "var_limit": 0.1,
      "correlation_filter": true,
      "diversification_check": true
    },
    "market_regime_adaptation": {
      "bull_market": {
        "position_bias": "long",
        "leverage_multiplier": 1.2,
        "risk_multiplier": 0.8
      },
      "bear_market": {
        "position_bias": "short",
        "leverage_multiplier": 1.1,
        "risk_multiplier": 1.2
      },
      "sideways_market": {
        "position_bias": "neutral",
        "leverage_multiplier": 0.8,
        "risk_multiplier": 1.5
      },
      "high_volatility": {
        "position_bias": "hedge",
        "leverage_multiplier": 0.6,
        "risk_multiplier": 2.0
      }
    }
  },
  "advanced_learning": {
    "curriculum": {
      "enabled": true,
      "stages": [
        {
          "name": "exploration",
          "timesteps": 20000,
          "learning_rate": 0.001,
          "focus": "high_entropy_exploration",
          "entropy_coef": "auto_1.0"
        },
        {
          "name": "foundation",
          "timesteps": 30000,
          "learning_rate": 0.0005,
          "focus": "basic_market_patterns",
          "entropy_coef": "auto_0.5"
        },
        {
          "name": "specialization",
          "timesteps": 40000,
          "learning_rate": 0.0002,
          "focus": "market_condition_adaptation",
          "entropy_coef": "auto_0.2"
        },
        {
          "name": "optimization",
          "timesteps": 30000,
          "learning_rate": 0.0001,
          "focus": "advanced_position_management",
          "entropy_coef": "auto_0.1"
        }
      ]
    },
    "ensemble": {
      "enabled": true,
      "members": 5,
      "specializations": ["bull", "bear", "sideways", "high_vol", "low_vol"],
      "voting_mechanism": "weighted_confidence",
      "diversity_weight": 0.4,
      "consensus_requirement": {
        "enabled": true,
        "min_agreement": 0.7,
        "max_confidence_gap": 0.3
      }
    },
    "meta_learning": {
      "enabled": true,
      "adaptation_rate": 0.01,
      "task_similarity_threshold": 0.8
    },
    "continual_learning": {
      "enabled": true,
      "memory_size": 10000,
      "replay_ratio": 0.3
    }
  },
  "evaluation": {
    "eval_freq": 5000,
    "n_eval_episodes": 10,
    "deterministic": true,
    "render": false
  },
  "logging": {
    "tensorboard_log": "tensorboard_logs/v432_1",
    "verbose": 1,
    "log_interval": 100
  }
}
