{
  "version": "v431.1",
  "description": "SAC v431.1: Enhanced Advanced Learning Framework with Market-Adaptive Rewards",
  "algorithm": "sac",
  "reward_function": {
    "sell_bonus": 0.25,
    "hold_bonus": 0.01,
    "buy_bonus": 0.25,
    "market_adaptive": {
      "sideways_multiplier": 1.5,
      "high_vol_multiplier": 1.2,
      "low_vol_multiplier": 0.8
    },
    "risk_penalty": 0.05,
    "time_penalty": 0.001
  },
  "action_thresholds": {
    "sell_threshold": -0.15,
    "buy_threshold": 0.15,
    "hold_range": [-0.15, 0.15],
    "adaptive_thresholds": true
  },
  "advanced_learning": {
    "curriculum": {
      "enabled": true,
      "stages": [
        {
          "name": "warmup",
          "timesteps": 15000,
          "learning_rate": 0.001,
          "focus": "exploration"
        },
        {
          "name": "foundation",
          "timesteps": 25000,
          "learning_rate": 0.0007,
          "focus": "basic_patterns"
        },
        {
          "name": "specialization",
          "timesteps": 30000,
          "learning_rate": 0.0003,
          "focus": "market_adaptation"
        },
        {
          "name": "optimization",
          "timesteps": 20000,
          "learning_rate": 0.0001,
          "focus": "fine_tuning"
        },
        {
          "name": "refinement",
          "timesteps": 10000,
          "learning_rate": 0.00005,
          "focus": "precision"
        }
      ]
    },
    "multi_stage": {
      "enabled": true,
      "stages": [
        {
          "name": "exploration",
          "timesteps": 30000,
          "focus": "high_entropy_exploration",
          "entropy_coef": "auto_1.0"
        },
        {
          "name": "exploitation",
          "timesteps": 35000,
          "focus": "optimal_policy_learning",
          "entropy_coef": "auto_0.1"
        },
        {
          "name": "specialization",
          "timesteps": 25000,
          "focus": "market_condition_adaptation",
          "entropy_coef": "auto_0.01"
        },
        {
          "name": "fine_tuning",
          "timesteps": 10000,
          "focus": "policy_refinement",
          "entropy_coef": "auto_0.001"
        }
      ]
    },
    "ensemble": {
      "enabled": true,
      "members": 5,
      "specializations": ["bull", "bear", "sideways", "high_vol", "low_vol"],
      "voting": "weighted_confidence",
      "diversity_weight": 0.3,
      "consensus_requirement": 0.6
    }
  },
  "risk_management": {
    "max_drawdown_limit": 0.1,
    "position_sizing": "adaptive",
    "stop_loss": 0.05,
    "take_profit": 0.1
  },
  "training": {
    "total_timesteps": 100000,
    "learning_rate": 0.0003,
    "gamma": 0.99,
    "tau": 0.005,
    "ent_coef": "auto_0.1",
    "target_entropy": "auto",
    "batch_size": 512,
    "buffer_size": 100000,
    "learning_starts": 1000,
    "gradient_steps": 1,
    "train_freq": [1, "step"]
  },
  "evaluation": {
    "eval_freq": 5000,
    "n_eval_episodes": 10,
    "deterministic": true,
    "market_scenarios": ["bull", "bear", "sideways", "high_vol", "low_vol"]
  }
}