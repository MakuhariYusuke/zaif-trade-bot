{
  "enabled_timeframes": [
    "1min",
    "5min",
    "15min",
    "1hour",
    "4hour",
    "1day"
  ],
  "base_timeframe": "5min",
  "feature_sets": {
    "1min": {
      "feature_set": "minimal",
      "window_sizes": [3, 5, 7, 10],
      "max_features": 50,
      "description": "High-frequency features for scalping and short-term analysis"
    },
    "5min": {
      "feature_set": "full",
      "window_sizes": [5, 10, 15, 20, 30],
      "max_features": 100,
      "description": "Balanced feature set for primary training timeframe"
    },
    "15min": {
      "feature_set": "full",
      "window_sizes": [10, 20, 30, 50, 100],
      "max_features": 150,
      "description": "Medium-term analysis with trend confirmation"
    },
    "1hour": {
      "feature_set": "full",
      "window_sizes": [20, 50, 100, 200],
      "max_features": 200,
      "description": "Hourly analysis for swing trading patterns"
    },
    "4hour": {
      "feature_set": "high_quality",
      "window_sizes": [50, 100, 200, 400],
      "max_features": 250,
      "description": "High-quality features for position trading"
    },
    "1day": {
      "feature_set": "high_quality",
      "window_sizes": [100, 200, 400, 800],
      "max_features": 300,
      "description": "Daily analysis for long-term market structure"
    }
  },
  "integration": {
    "include_timeframe_indicators": true,
    "timeframe_alignment_method": "forward_fill",
    "max_timeframe_lag": "4hour",
    "feature_prefixing": true,
    "timeframe_weights": {
      "1min": 0.1,
      "5min": 0.3,
      "15min": 0.2,
      "1hour": 0.2,
      "4hour": 0.1,
      "1day": 0.1
    }
  },
  "quality_control": {
    "max_nan_rate": 0.10,
    "min_variance": 1e-8,
    "max_correlation": 0.95,
    "remove_outliers": true,
    "feature_stability_check": true
  },
  "performance": {
    "parallel_processing": true,
    "cache_features": true,
    "memory_limit_mb": 2048,
    "chunk_size": 1000
  },
  "metadata": {
    "version": "1.0.0",
    "description": "Multi-timeframe feature engineering configuration for SAC v427+",
    "created": "2025-01-26",
    "supported_timeframes": ["1min", "5min", "15min", "1hour", "4hour", "1day"]
  }
}
