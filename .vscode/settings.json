{
    "chat.tools.terminal.autoApprove": {
        "/.*/": true
    },
    "chatgpt.openOnStartup": false,
    "python.defaultInterpreterPath": "c:\\Users\\Admin\\dev\\zaif-trade-bot\\.venv\\Scripts\\python.exe",
    "python.terminal.activateEnvironment": true,
    "python-envs.defaultEnvManager": "venv",
    "python-envs.pythonProjects": [],
    "python.analysis.autoImportCompletions": true,
    "python.languageServer": "Pylance",
    "python.venvPath": "c:\\Users\\Admin\\dev\\zaif-trade-bot\\.venv",
    "python.venvFolders": [".venv"],

    // --- パフォーマンス最適化 (644#) ---
    // ファイルウォッチャー: 大量ファイルディレクトリを除外
    "files.watcherExclude": {
        "**/checkpoints/**": true,
        "**/.venv/**": true,
        "**/.mypy_cache/**": true,
        "**/data/**": true,
        "**/models/**": true,
        "**/results/**": true,
        "**/logs/**": true,
        "**/htmlcov/**": true,
        "**/__pycache__/**": true,
        "**/runs/**": true,
        "**/tensorboard/**": true,
        "**/reports/**": true,
        "**/temp/**": true,
        "**/cache/**": true,
        "**/optimization_results/**": true,
        "**/exports/**": true,
        "**/training_results/**": true,
        "**/grad_probe_archives/**": true,
        "**/backtest/**": true,
        "**/backtest_experiments/**": true,
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/**": true,
        "**/config/**": true,
        "**/.hypothesis/**": true,
        "**/archived/**": true,
        "**/analysis_results/**": true,
        "**/plots/**": true,
        "**/notebooks/**": true,
        "**/experiments/**": true,
        "**/assets/**": true
    },
    // 検索除外: IDE検索から不要ディレクトリ除外
    "search.exclude": {
        "**/checkpoints/**": true,
        "**/.venv/**": true,
        "**/.mypy_cache/**": true,
        "**/data/**": true,
        "**/models/**": true,
        "**/htmlcov/**": true,
        "**/__pycache__/**": true,
        "**/tensorboard/**": true,
        "**/grad_probe_archives/**": true,
        "**/exports/**": true,
        "**/.git/**": true,
        "**/config/**": true,
        "**/.hypothesis/**": true,
        "**/archived/**": true,
        "**/analysis_results/**": true,
        "**/logs/**": true,
        "**/results/**": true,
        "**/reports/**": true,
        "**/training_results/**": true,
        "**/optimization_results/**": true
    },
    // エクスプローラーから不要ファイル/ディレクトリ非表示
    "files.exclude": {
        "**/__pycache__": true,
        "**/.mypy_cache": true,
        "**/*.pyc": true,
        "**/htmlcov": true,
        "**/.coverage": true,
        "**/.hypothesis": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "**/checkpoints": true,
        "**/tensorboard": true,
        "**/grad_probe_archives": true,
        "**/exports": true,
        "**/training_results": true,
        "**/optimization_results": true,
        "**/backtest_experiments": true,
        "**/config": true,
        "**/plots": true,
        "**/notebooks": true,
        "**/prometheus_client": true,
        "**/archived": true
    },
    // Pylance メモリ制限
    "python.analysis.indexing": true,
    "python.analysis.persistAllIndices": false,
    "python.analysis.autoSearchPaths": false,
    "python.analysis.diagnosticMode": "openFilesOnly",
    // Pylance: 非ソースディレクトリは解析除外
    "python.analysis.exclude": [
        "**/archived/**",
        "**/sb3_contrib/**",
        "**/checkpoints/**",
        "**/data/**",
        "**/models/**",
        "**/htmlcov/**",
        "**/tensorboard/**",
        "**/exports/**",
        "**/backtest/**",
        "**/backtest_experiments/**",
        "**/optimization_results/**",
        "**/training_results/**",
        "**/grad_probe_archives/**",
        "**/config/**",
        "**/.hypothesis/**",
        "**/logs/**",
        "**/results/**",
        "**/reports/**",
        "**/temp/**",
        "**/cache/**"
    ],
    "python.analysis.diagnosticSeverityOverrides": {
        "reportMissingImports": "warning"
    },
    // ターミナル蓄積防止
    "terminal.integrated.persistentSessionReviveProcess": "never",
    "terminal.integrated.enablePersistentSessions": false,
    // Git: 大規模リポジトリでの自動操作を抑制
    "git.autorefresh": false,
    "git.autofetch": false,
    "git.decorations.enabled": false,
    // エディタ: メモリ節約
    "editor.bracketPairColorization.enabled": false,
    "editor.guides.bracketPairs": false,
    "extensions.autoUpdate": false,
    // ファイル自動保存を遅延 (ウォッチャー負荷軽減)
    "files.autoSaveDelay": 5000
}
