{
  "algorithm": "sac",
  "model_name": "sac_v435.4",
  "version": "4.3.5.4",
  "training": {
    "data_config": {
      "data_path": "data/btc_jpy_yahoo_real_20251021_featured.csv",
      "validation_split": 0.2,
      "test_split": 0.1
    },
    "total_timesteps": 10000,
    "sac_hyperparameters": {
      "learning_rate": 5e-4,
      "batch_size": 128,
      "buffer_size": 1000000,
      "learning_starts": 1000,
      "tau": 0.005,
      "gamma": 0.99,
      "ent_coef": "auto_1.0",
      "target_entropy": "auto"
    },

    "environment": {
      "transaction_cost": 0.0,
      "max_position_size": 1.0,
      "random_start": true,
      "enable_correlation_reduction": true,
      "correlation_threshold": 0.85,
      "max_features": 100,
      "feature_adaptation": true,
      "market_regime_detection": true
    },

      "reward_settings": {
        "base_profit_bonus_atr_coeff": 8.0,
        "base_profit_bonus_portfolio_coeff": 15.0,
        "base_action_penalty": 0.05,
        "loss_penalty_coeff": -2.0,
        "action_frequency_penalty": 0.0,
        "long_short_asymmetry": true,
        "risk_adjusted_bonus": true,
        "market_regime_penalty": true,
        "profit_bonus_multiplier": 1.5
      }
    },

  "features": {
    "technical_indicators": [
      "rsi_14", "macd", "macd_signal", "macd_hist",
      "bb_upper", "bb_middle", "bb_lower", "bb_width",
      "stoch_k", "stoch_d", "williams_r",
      "ichimoku_tenkan", "ichimoku_kijun", "ichimoku_senkou_a", "ichimoku_senkou_b",
      "atr_14", "cci_14", "mfi_14", "roc_12", "mom_10",
      "trix", "kama", "tsf", "uo"
    ],
    "price_features": [
      "price_change", "volume_change", "returns", "log_returns",
      "sma_5", "sma_10", "sma_20", "sma_50",
      "ema_5", "ema_10", "ema_20", "ema_50",
      "vwap", "price_volume_trend", "obv"
    ],
    "volatility_features": [
      "volatility_5", "volatility_10", "volatility_20",
      "atr_5", "atr_10", "atr_20",
      "bollinger_volatility", "close_to_bb_ratio",
      "parabolic_sar", "chaikin_volatility"
    ],
    "momentum_features": [
      "momentum_5", "momentum_10", "momentum_20",
      "roc_5", "roc_10", "roc_20",
      "williams_r_5", "williams_r_10",
      "stochastic_oscillator", "awesome_oscillator"
    ]
  },

  "validation": {
    "enabled": true,
    "validation_freq": 500,
    "n_eval_episodes": 5,
    "deterministic_eval": true,
    "validation_threshold": 0.8
  },

  "logging": {
    "tensorboard_log": "./tensorboard/sac_v435.4",
    "verbose": 1,
    "log_interval": 50
  },

  "checkpoint": {
    "save_freq": 500,
    "save_path": "./checkpoints",
    "save_replay_buffer": false,
    "load_replay_buffer": false
  }
}
