{
  "experiment_name": "v435.2_adaptive_features_variant",
  "description": "Variant experiment for v435 with adaptive feature selection",
  "config_files": {
    "sac_config": "sac_v435_config.json",
    "environment_config": "sac_v435_environment_config.json",
    "reward_config": "sac_v435_reward_config.json"
  },
  "training_params": {
    "total_timesteps": 1000000,
    "eval_freq": 10000,
    "save_freq": 50000,
    "adaptive_features": true,
    "feature_selection_threshold": 0.7
  },
  "backtest_params": {
    "test_periods": ["2023-01-01", "2024-01-01"],
    "initial_balance": 10000,
    "fee_rate": 0.001,
    "regime_adaptation": true
  },
  "metrics": [
    "total_return",
    "sharpe_ratio",
    "max_drawdown",
    "win_rate",
    "profit_factor",
    "feature_utilization"
  ]
}
