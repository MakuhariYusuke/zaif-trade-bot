def test_v440_reward_enhancements():        action = np.random.choice([ACTION_HOLD, ACTION_BUY, ACTION_SELL])

    """Test various reward enhancements in v440."""

        reward = calculator.calculate_reward_simple(

    # Mock config            pnl=pnl,

    class MockConfig:            portfolio_value=10000.0,

        def __init__(self):            position=0.0,

            self.curriculum_stage = "basic"            old_position=0.0,

            self.max_position_size = 1.0            action=action,

            reward_history=[],

    config = MockConfig()            portfolio_value_history=[]

        )

    reward_settings = RewardSettings(

        profit_weight=1.0,        actions.append(action)

        risk_weight=0.1,        rewards.append(reward)

        consistency_weight=0.1,

        reward_scale=1.0,    hold_count = actions.count(ACTION_HOLD)

        reward_clip_min=-40.0,    buy_count = actions.count(ACTION_BUY)

        reward_clip_max=40.0,    sell_count = actions.count(ACTION_SELL)

        use_simple_reward=True,

        hold_penalty_multiplier=1.01,    print(f"HOLD: {hold_count} ({hold_count/100:.1%})")

        trade_frequency_bonus=0.001,    print(f"BUY: {buy_count} ({buy_count/100:.1%})")

        reward_scaling=1.0,    print(f"SELL: {sell_count} ({sell_count/100:.1%})")

        reward_clip_value=10.0,    print(".3f")

        dynamic_reward_shaping_enabled=False,  # Disable for basic test    print(".3f")

        market_regime_awareness=False,

        volatility_adjusted_rewards=False,if __name__ == "__main__":

        trend_strength_bonus=False,    test_v440_reward_function()
        profit_multiplier=0.01,
        loss_penalty_multiplier=0.01,
        hold_penalty_rate=0.01,
        balance_penalty_tolerance=0.15,
        balance_penalty=1.0,
        trading_bonus_multiplier=2.0,
        trading_bonus=0.01,
    )

    calculator = RewardCalculator(
        config=config,
        reward_settings=reward_settings,
        initial_portfolio_value=10000.0
    )

    # Test reward clipping
    large_reward = calculator.calculate_reward_simple(
        pnl=1000.0,
        portfolio_value=10000.0,
        position=0.1,
        old_position=0.0,
        action=ACTION_BUY,
        reward_history=[],
        portfolio_value_history=[10000.0]
    )
    assert large_reward <= 40.0, "Large rewards should be clipped"

    large_penalty = calculator.calculate_reward_simple(
        pnl=-1000.0,
        portfolio_value=10000.0,
        position=0.1,
        old_position=0.0,
        action=ACTION_SELL,
        reward_history=[],
        portfolio_value_history=[10000.0]
    )
    assert large_penalty >= -40.0, "Large penalties should be clipped"