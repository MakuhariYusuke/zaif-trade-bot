{
  "session_id": "ppo_reward_v1_antihold",
  "algorithm": "ppo",
  "description": "Reward v1: HOLD超ペナルティ + 連続HOLD追加ペナルティ + 取引頻度ボーナス",

  "comment_experiment": "Experiment 1: Extreme anti-HOLD reward structure",
  "comment_strategy": "25x hold_penalty + consecutive_hold_penalty + trading_frequency_bonus",
  "comment_target": "HOLD <40%, Reward >100, Active trading",

  "max_features": 60,
  "enable_correlation_reduction": false,

  "data_rows_limit": 500,

  "ppo": {
    "learning_rate": 0.0003,
    "n_steps": 512,
    "batch_size": 128,
    "n_epochs": 6,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_range": 0.2,
    "clip_range_vf": null,
    "ent_coef": 0.05,
    "vf_coef": 0.5,
    "max_grad_norm": 0.5,
    "use_sde": false,
    "sde_sample_freq": -1,
    "policy_kwargs": {
      "net_arch": [
        {"pi": [128, 128], "vf": [128, 128]}
      ]
    }
  },

  "environment": {
    "initial_balance": 10000,
    "transaction_cost": 0.0001,
    "max_position_size": 1.0,
    "enable_action_masking": true,
    "reward_settings": {
      "hold_penalty_weight": 0.005,
      "consecutive_hold_penalty": 0.002,
      "trading_frequency_bonus": 0.05,
      "profit_reward_multiplier": 1.5,
      "action_diversity_bonus": 0.01
    }
  },

  "training": {
    "total_timesteps": 5000,
    "checkpoint_interval": 5000,
    "enable_autohalt": true,
    "eval_freq": 2000,
    "n_eval_episodes": 5,
    "reward_scaling": 1.0
  },

  "custom_ppo": {
    "enabled": true,
    "use_pan": true,
    "use_target_entropy": true,
    "use_gradient_probe_guard": false,
    "pan_epsilon": 1e-8,
    "enable_evaluation_gates": true,
    "gate_thresholds": {
      "variance_threshold": 0.01,
      "distribution_check_enabled": true
    }
  },

  "data_path": "ml-dataset-enhanced-balanced.csv",

  "comment_changes": "Key changes from v371:",
  "changes": [
    "hold_penalty_weight: 0.002 → 0.005 (2.5x, 25x from baseline)",
    "consecutive_hold_penalty: NEW 0.002 (cumulative penalty)",
    "trading_frequency_bonus: NEW 0.05 (encourage active trading)",
    "Other settings: Same as v371"
  ],

  "expected_behavior": {
    "hold_rate_target": "<40%",
    "buy_sell_rate_target": ">60%",
    "reward_target": ">100 (strongly positive)",
    "exploration_level": "very high (ent_coef=0.05)",
    "trade_pattern": "Highly active, aggressive BUY/SELL"
  }
}
