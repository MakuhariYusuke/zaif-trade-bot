{
  "session_id": "ppo_hybrid_active_v374",
  "algorithm": "ppo",
  "description": "Hybrid: Best settings from Exp1/4/5 - High LR + High Entropy + HOLD Penalty",

  "comment_experiment": "Experiment 6: Hybrid combination of best HOLD reduction strategies",
  "comment_strategy": "learning_rate=0.0005 (Exp5) + ent_coef=0.1 (Exp4) + hold_penalty=0.005 (Exp1)",
  "comment_target": "HOLD <45%, Reward >-150, Active trading >50%",

  "max_features": 60,
  "enable_correlation_reduction": false,

  "data_rows_limit": 500,

  "ppo": {
    "learning_rate": 0.0005,
    "n_steps": 512,
    "batch_size": 128,
    "n_epochs": 6,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_range": 0.2,
    "clip_range_vf": null,
    "ent_coef": 0.1,
    "vf_coef": 0.5,
    "max_grad_norm": 0.5,
    "use_sde": false,
    "sde_sample_freq": -1,
    "policy_kwargs": {
      "net_arch": [
        {"pi": [128, 128], "vf": [128, 128]}
      ]
    }
  },

  "environment": {
    "initial_balance": 10000,
    "transaction_cost": 0.0001,
    "max_position_size": 1.0,
    "enable_action_masking": true,
    "reward_settings": {
      "hold_penalty_weight": 0.005,
      "consecutive_hold_penalty": 0.002,
      "trading_frequency_bonus": 0.05,
      "profit_reward_multiplier": 1.5,
      "action_diversity_bonus": 0.01
    }
  },

  "training": {
    "total_timesteps": 5000,
    "checkpoint_interval": 5000,
    "enable_autohalt": true,
    "eval_freq": 2000,
    "n_eval_episodes": 5,
    "reward_scaling": 1.0
  },

  "custom_ppo": {
    "enabled": true,
    "use_pan": true,
    "use_target_entropy": true,
    "use_gradient_probe_guard": false,
    "pan_epsilon": 1e-8,
    "enable_evaluation_gates": true,
    "gate_thresholds": {
      "variance_threshold": 0.01,
      "distribution_check_enabled": true
    }
  },

  "data_path": "ml-dataset-enhanced-balanced.csv",

  "comment_changes": "Hybrid combination from experiments:",
  "changes": [
    "learning_rate: 0.0005 (from Exp5 - best HOLD reduction)",
    "ent_coef: 0.1 (from Exp4 - second best HOLD)",
    "hold_penalty_weight: 0.005 (from Exp1 - best reward)",
    "consecutive_hold_penalty: 0.002 (from Exp1)",
    "trading_frequency_bonus: 0.05 (from Exp1)"
  ],

  "expected_behavior": {
    "hold_rate_target": "<45%",
    "buy_sell_rate_target": ">55%",
    "reward_target": ">-150 (better than any single experiment)",
    "exploration_level": "MAXIMUM (lr=0.0005, ent=0.1)",
    "trade_pattern": "Highly active, diverse, fast learning"
  },

  "hypothesis": "Combining fast learning (Exp5) + high exploration (Exp4) + strong penalties (Exp1) will achieve both low HOLD and better reward than individual experiments"
}
