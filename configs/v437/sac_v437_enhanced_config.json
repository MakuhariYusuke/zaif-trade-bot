{
  "model_name": "sac_v437_enhanced_features",
  "algorithm": "sac",
  "version": "v437.1",
  "total_timesteps": 1000,
  "data_path": "data/btc_jpy_real_dataset.csv",
  "sac_hyperparameters": {
    "learning_rate": 0.0003,
    "buffer_size": 100000,
    "learning_starts": 1000,
    "batch_size": 256,
    "tau": 0.005,
    "gamma": 0.99,
    "ent_coef": 0.01,
    "target_update_interval": 1,
    "target_entropy": -2.0,
    "seed": 43
  },
  "environment": {
    "initial_balance": 200000.0,
    "transaction_cost": 1e-05,
    "max_position_size": 1.0,
    "enable_action_masking": true,
    "use_continuous_actions": true,
    "use_standardized_observations": true,
    "random_start": true,
    "curriculum_stage": "balanced_trading",
    "continuous_to_discrete_threshold": 0.1,
    "feature_set": "full",
    "enhanced_features": {
      "enabled": true,
      "target_dimensions": 150,
      "feature_engineering": {
        "regime_features": true,
        "correlation_features": true,
        "ensemble_features": true,
        "risk_features": true,
        "momentum_features": true,
        "volatility_features": true,
        "volume_features": true,
        "trend_features": true
      },
      "trading_frequency_control": {
        "min_steps_between_trades": 5,
        "max_trades_per_episode": 50,
        "trading_penalty_coefficient": 0.001
      }
    },
    "adaptive_feature_selection": {
      "enabled": true,
      "regime_classifier": {
        "adx_threshold": 25.0,
        "volatility_percentile": 70.0
      },
      "attention_layer": {
        "enabled": true,
        "hidden_dim": 128
      },
      "min_weight_threshold": 0.3
    },
    "reward_settings": {
      "use_simple_reward": false,
      "reward_scale": 100.0,
      "trading_bonus": 0.005,
      "profit_bonuses": {
        "trading_bonus": 0.005,
        "profit_multiplier": 1.0,
        "loss_penalty": 0.5
      },
      "hold_penalty": 0.0001,
      "entropy_bonus": 0.001,
      "trading_frequency_penalty": {
        "enabled": true,
        "coefficient": 0.001,
        "min_steps_threshold": 5
      }
    }
  },
  "training": {
    "save_freq": 10000,
    "eval_freq": 5000,
    "log_interval": 1000,
    "verbose": 1,
    "tensorboard_log": "tensorboard/v437"
  },
  "evaluation": {
    "n_eval_episodes": 10,
    "deterministic": true,
    "render_mode": null
  },
  "backtest": {
    "enabled": true,
    "output_dir": "backtest_experiments/v437.1",
    "analysis_types": ["performance", "risk", "feature_importance"]
  }
}
