{
  "session_id": "ppo_reward_v379_dynamic_short",
  "algorithm": "ppo",
  "description": "Reward Improvement v2: Dynamic scale with market adaptation - SHORT RUN for action distribution analysis",

  "comment_experiment": "v379_short: Short run version for TensorBoard action metrics testing",
  "comment_strategy": "Same as v379_dynamic but with reduced timesteps for quick validation",

  "curated_features_list": "curated_features.py::CURATED_FEATURES",
  "enable_feature_filtering": true,
  "feature_filter_mode": "whitelist",

  "max_features": null,
  "enable_correlation_reduction": false,

  "data_rows_limit": null,

  "ppo": {
    "learning_rate": 0.0003,
    "n_steps": 512,
    "batch_size": 128,
    "n_epochs": 6,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_range": 0.2,
    "clip_range_vf": null,
    "ent_coef": 0.06,
    "vf_coef": 0.5,
    "max_grad_norm": 0.5,
    "use_sde": false,
    "sde_sample_freq": -1,
    "target_kl": 0.03,
    "policy_kwargs": {
      "net_arch": [
        {"pi": [128, 128], "vf": [128, 128]}
      ]
    }
  },

  "environment": {
    "initial_balance": 10000,
    "transaction_cost": 0.0001,
    "max_position_size": 1.0,
    "enable_action_masking": true,
    "random_start": true,
    "reward_settings": {
      "hold_penalty_weight": 0.02,
      "consecutive_hold_penalty": 0.01,
      "consecutive_hold_exponential": true,
      "consecutive_hold_threshold": 5,
      "trading_frequency_bonus": 0.15,
      "profit_reward_multiplier": 3.0,
      "action_diversity_bonus": 0.05,
      "successful_trade_bonus": 0.5,
      "volatility_adjusted_penalty": true,
      "trend_adjusted_bonus": true,
      "range_market_hold_tolerance": 0.5
    }
  },

  "training": {
    "total_timesteps": 5000,
    "checkpoint_interval": 1000,
    "enable_autohalt": false,
    "eval_freq": 500,
    "n_eval_episodes": 5,
    "reward_scaling": 1.0
  },

  "custom_ppo": {
    "enabled": true,
    "use_pan": true,
    "use_target_entropy": true,
    "target_entropy": -0.8,
    "use_gradient_probe_guard": false,
    "pan_epsilon": 1e-8,
    "enable_evaluation_gates": false,
    "gate_thresholds": {
      "variance_threshold": 0.01,
      "distribution_check_enabled": true
    }
  },

  "data_path": "ml-dataset-enhanced-balanced.csv"
}