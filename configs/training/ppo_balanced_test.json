{
  "comment": "Balanced training configuration with forced diversity",
  "algorithm": "ppo",
  "data_path": "ml-dataset-enhanced.csv",
  "session_id": "ppo_balanced_test",
  "total_timesteps": 30000,
  "_comment_ppo": "Conservative PPO parameters for stable learning",
  "learning_rate": 0.0003,
  "n_steps": 1024,
  "batch_size": 64,
  "n_epochs": 10,
  "gamma": 0.99,
  "ent_coef": 0.05,
  "vf_coef": 0.5,
  "max_grad_norm": 0.5,
  "clip_range": 0.2,
  "gae_lambda": 0.95,
  "target_kl": 0.02,
  "normalize_advantage": true,
  "seed": 42,
  "_comment_mitigation": "Strong diversity enforcement",
  "enable_sell_mitigation": true,
  "enable_lagrange": true,
  "lagrange_warmup_steps": 1000,
  "lagrange_r_target": 0.33,
  "lagrange_tolerance": 0.05,
  "lagrange_eta": 0.05,
  "lagrange_lambda_max": 2.0,
  "enable_probes": true,
  "enable_weights": false,
  "enable_pan": true,
  "enable_target_entropy": false,
  "enable_stratified_sampling": false,
  "_comment_environment": "Environment settings with forced balance",
  "transaction_cost": 0.001,
  "max_position_size": 0.5,
  "curriculum_stage": "forced_balance",
  "allow_reverse": true,
  "_comment_reward": "Balanced reward settings",
  "reward_settings": {
    "enable_forced_diversity": true,
    "profit_bonus_multipliers": [
      1.0,
      1.0,
      1.0
    ],
    "action_penalty_scale": 0.01,
    "position_soft_cap": 0.8,
    "position_penalty_scale": 0.1,
    "position_penalty_exp": 2.0,
    "inventory_penalty_scale": 0.01,
    "trade_frequency_penalty": 0.01,
    "trade_frequency_halflife": 8.0,
    "trade_cooldown_steps": 2,
    "trade_cooldown_penalty": 0.01,
    "max_consecutive_trades": 10,
    "consecutive_trade_penalty": 0.05,
    "volatility_penalty_scale": 0.01,
    "sharpe_bonus_scale": 0.01,
    "reward_clip_value": 2.0
  },
  "_comment_validation": "Balanced validation criteria",
  "target_sell_rate_min": 0.25,
  "target_sell_rate_optimal": 0.33,
  "grad_norm_threshold": 1e-06,
  "moving_window": 3000,
  "_comment_output": "Output paths",
  "model_save_path": "models/ppo_balanced_test.zip",
  "log_dir": "logs/ppo_balanced_test",
  "tensorboard_log": "tensorboard/ppo_balanced_test",
  "checkpoint_freq": 5000,
  "verbose": 1,
  "_comment_callbacks": "Callback configurations",
  "callbacks": {
    "checkpoint": {
      "enabled": true,
      "save_freq": 5000,
      "name_prefix": "balanced_checkpoint"
    },
    "eval": {
      "enabled": false
    }
  },
  "reward_scaling": 6.0
}
