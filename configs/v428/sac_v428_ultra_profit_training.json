{
  "model_name": "sac_v428_ultra_profit_optimized",
  "algorithm": "sac",
  "total_timesteps": 50000,
  "data_source": "csv",
  "data_path": "data/btc_jpy_extended_dataset.csv",
  "sac_hyperparameters": {
    "learning_rate": 0.007441015314076285,
    "buffer_size": 200000,
    "learning_starts": 1000,
    "batch_size": 64,
    "tau": 0.00880540073794548,
    "gamma": 0.9086614354464461,
    "ent_coef": 0.003522806125338838,
    "target_update_interval": 1,
    "target_entropy": -2.0
  },
  "environment": {
    "initial_balance": 200000.0,
    "transaction_cost": 0.001,
    "max_position_size": 1.0,
    "enable_action_masking": true,
    "use_continuous_actions": true,
    "use_standardized_observations": true,
    "random_start": false,
    "feature_set": "v427_adaptive"
  },
  "reward_settings": {
    "reward_scale": 1.0,
    "reward_clip_min": -10.0,
    "reward_clip_max": 10.0,
    "use_simple_reward": false,
    "profit_weight": 5.0,
    "risk_weight": 0.05,
    "consistency_weight": 0.2,
    "ultra_profit_multiplier": 2.0,
    "ultra_risk_multiplier": 0.5,
    "profit_multiplier": 0.01,
    "loss_penalty_multiplier": 0.01
  },
  "logging": {
    "log_interval": 1000,
    "eval_interval": 5000,
    "save_interval": 5000,
    "verbose": true
  },
  "output": {
    "results_dir": "results",
    "reports_dir": "reports",
    "models_dir": "models"
  }
}
