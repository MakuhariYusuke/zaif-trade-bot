{
  "algorithm": "sac",
  "model": {
    "name": "sac_test_1ksteps",
    "version": "test_logger"
  },
  "training": {
    "total_timesteps": 1000,
    "save_freq": 500,
    "log_interval": 100,
    "seed": 42
  },
  "algorithm_params": {
    "learning_rate": 0.0003,
    "buffer_size": 50000,
    "learning_starts": 100,
    "batch_size": 256,
    "tau": 0.005,
    "gamma": 0.99,
    "train_freq": 1,
    "gradient_steps": 1,
    "target_update_interval": 1,
    "policy_kwargs": {
      "net_arch": [256, 256]
    }
  },
  "environment": {
    "data_path": "btc_jpy_real_dataset.csv",
    "initial_balance": 100000,
    "commission_rate": 0.001,
    "position_size": 0.1
  },
  "callbacks": {
    "tensorboard": {
      "enabled": true,
      "log_dir": "tensorboard_logs/sac_test_1ksteps"
    }
  },
  "output": {
    "model_dir": "models/sac_test",
    "logs_dir": "logs/sac_test"
  }
}
