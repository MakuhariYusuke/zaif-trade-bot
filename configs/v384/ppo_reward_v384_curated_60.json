{
  "session_id": "ppo_reward_v384_curated_60",
  "algorithm": "ppo",
  "description": "v381改良版: 厳選60特徴量セットで訓練 - 冗長・相関高・単独無意味な特徴を除外",

  "comment_experiment": "v384: 質的改善特徴セット（60個）を使用",
  "comment_strategy": "平均足OHLCを除外、一目均衡表は組み合わせのみ、高相関ペアを削除",
  "comment_target": "特徴量の質を向上させ、学習効率とパフォーマンスを改善",

  "comment_improvements_from_v381": [
    "✅ 110特徴量 → 60特徴量（45%削減）",
    "✅ 平均足: OHLC除外、色連続のみ保持",
    "✅ 一目均衡表: 単独線を除外、組み合わせ指標のみ",
    "✅ 高相関ペア: price/close, sma_long/BB_Middle等を除外",
    "✅ Time系定数: DOW等の分散ゼロ特徴を除外",
    "✅ トレーニングラベル: pnl, win を除外",
    "✅ 冗長なMA系: KAMA, sma_short等を除外"
  ],

  "curated_features_list": "curated_features.py::CURATED_FEATURES",
  "enable_feature_filtering": true,
  "feature_filter_mode": "whitelist",

  "data_path": "ml-dataset-enhanced.csv",
  "max_features": null,
  "enable_correlation_reduction": false,

  "data_rows_limit": null,

  "ppo": {
    "total_timesteps": 50000,
    "learning_rate": 0.003,
    "n_steps": 1024,
    "batch_size": 256,
    "n_epochs": 10,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_range": 0.1,
    "clip_range_vf": null,
    "normalize_advantage": true,
    "ent_coef": 0.01,
    "vf_coef": 0.3,
    "max_grad_norm": 0.5,
    "use_sde": false,
    "sde_sample_freq": -1,
    "target_kl": 0.01,
    "stats_window_size": 100,
    "tensorboard_log": "runs",
    "verbose": 1,
    "seed": null,
    "device": "cpu",
    "pan_enabled": true,
    "pan_alpha_lr": 0.01,
    "pan_target_entropy_ratio": 0.7
  },

  "environment": {
    "transaction_cost": 0.0005,
    "max_position_size": 0.5,
    "initial_balance": 10000.0,
    "curriculum_stage": "forced_balance",
    "feature_set": "full",
    "enable_correlation_reduction": false,
    "correlation_threshold": 0.95,
    "enable_feature_filtering": true,
    "feature_filter_mode": "whitelist",
    "curated_features_list": "curated_features.py::CURATED_FEATURES"
  },

  "reward": {
    "hold_penalty_weight": 0.05,
    "consecutive_hold_penalty": 0.02,
    "consecutive_hold_threshold": 3,
    "consecutive_hold_exponential": true,
    "profit_reward_multiplier": 5.0,
    "loss_penalty_multiplier": 1.0,
    "action_diversity_bonus": 0.05,
    "trading_frequency_bonus": 0.25,
    "successful_trade_bonus": 1.0,
    "risk_adjusted_return_weight": 0.5,
    "max_drawdown_penalty": 0.3,
    "sharpe_ratio_bonus": 0.2
  },

  "lagrange_constraints": {
    "enabled": true,
    "r_target": 0.175,
    "tolerance": 0.042625,
    "eta": 0.062875,
    "lambda_init": 1.0,
    "lambda_max": 3.875,
    "lambda_min": 0.0,
    "warmup_steps": 3874,
    "adaptation_rate": 0.01
  },

  "training": {
    "model_save_path": "models/ppo_reward_v384_curated_60.zip",
    "checkpoint_dir": "checkpoints",
    "checkpoint_interval": 10000,
    "log_interval": 1,
    "eval_freq": -1,
    "n_eval_episodes": 5,
    "eval_log_path": null,
    "tb_log_name": "ppo_reward_v384_curated_60",
    "reset_num_timesteps": true,
    "progress_bar": true
  },

  "reproducibility": {
    "seed": 42,
    "deterministic_actions": false
  }
}
