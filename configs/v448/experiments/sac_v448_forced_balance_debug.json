{
  "version": "4.4.8-v448.forced-balance-debug",
  "description": "Small-scale config that stresses forced balance and emergency intervention logic after the history window fix.",
  "training": {
    "model_name": "sac_v448_forced_balance_debug",
    "algorithm": "sac",
    "total_timesteps": 3000,
    "eval_freq": 500,
    "checkpoint_interval": 1000,
    "data_config": {
      "use_real_data": true,
      "data_path": "data/btc_jpy_1m_dataset.csv",
      "validation_split": 0.15
    },
    "environment": {
      "timeframe": "1m",
      "initial_balance": 200000.0,
      "transaction_cost": 0.001,
      "max_position_size": 1.0,
      "enable_action_masking": true,
      "use_continuous_actions": true,
      "curriculum_stage": "forced_balance",
      "reward_settings": {
        "use_simple_reward": false,
        "reward_scale": 1.5,
        "trading_bonus": 0.01,
        "penalty_coefficients": {
          "loss_penalty": -0.001,
          "large_loss_penalty": -0.01,
          "inactivity_penalty": -0.0001
        },
        "asymmetric_reward_scaling": {
          "long_position_reward_multiplier": 1.0,
          "short_position_reward_multiplier": 1.0,
          "long_position_penalty_multiplier": 1.0,
          "short_position_penalty_multiplier": 1.0
        },
        "balance_penalty_enabled": true,
        "balance_penalty": 6.0,
        "balance_penalty_min_actions": 60,
        "balance_penalty_tolerance": 0.04,
        "balance_penalty_targets": {
          "buy_target": 0.45,
          "sell_target": 0.45,
          "hold_target": 0.10
        },
        "balance_shaping_enabled": true,
        "balance_shaping_value": 0.05,
        "action_entropy_shaping_enabled": true,
        "action_entropy_shaping_value": 0.02,
        "skewness_penalty_enabled": true,
        "skewness_penalty_value": 0.5,
        "skewness_penalty_tolerance": 0.04,
        "skewness_lookback": 120,
        "forced_balance_min_actions": 120,
        "forced_balance_threshold": 0.08,
        "forced_balance.scaling": 1.0,
        "forced_balance.penalty.scale": 3.0,
        "forced_balance.penalty.threshold_small": 0.04,
        "forced_balance.penalty.threshold_medium": 0.08,
        "forced_balance.penalty.threshold_large": 0.15,
        "forced_balance.penalty.value_small_deviation": 20.0,
        "forced_balance.penalty.value_medium_deviation": 40.0,
        "forced_balance.penalty.value_large_deviation": 80.0,
        "forced_balance.penalty.value_very_large_deviation": 160.0,
        "forced_balance.bonus.scale": 2.5,
        "forced_balance.bonus.threshold_small": 0.03,
        "forced_balance.bonus.threshold_medium": 0.06,
        "forced_balance.bonus.value_small_deviation": 8.0,
        "forced_balance.bonus.value_medium_deviation": 16.0,
        "forced_balance.bonus.value_large_deviation": 32.0,
        "emergency_intervention_enabled": true,
        "emergency_intervention_threshold": 0.3,
        "emergency_intervention_penalty": -400.0,
        "forced_balance_emergency_penalty": 450.0,
        "trend_adjustment_enabled": true,
        "trend_adjustment_strength": 0.12
      },
      "behavior_optimization": {
        "consistency_penalty": 0.04,
        "action_balance_target": 0.45,
        "entropy_regularization": 0.05,
        "action_smoothing": 0.05
      },
      "action_bonuses": {
        "buy_action_bonus": 0.0,
        "sell_action_bonus": 0.0,
        "hold_action_bonus": 0.0
      },
      "curriculum_learning": {
        "enabled": true,
        "auto_progression": true,
        "stage_conditions": {
          "forced_balance": {
            "min_steps": 120,
            "balance_threshold": 0.12
          },
          "balanced_transition": {
            "min_steps": 200,
            "balance_threshold": 0.18,
            "avg_reward_threshold": 0.0
          }
        }
      },
      "multi_timeframe": {
        "base_timeframe": "1min",
        "enabled_timeframes": [
          "1min",
          "5min",
          "15min"
        ],
        "feature_weights": {
          "1min": 0.32,
          "5min": 0.45,
          "15min": 0.23
        }
      }
    },
    "sac_hyperparameters": {
      "learning_rate": 0.00015,
      "buffer_size": 50000,
      "learning_starts": 200,
      "batch_size": 256,
      "tau": 0.005,
      "gamma": 0.99,
      "ent_coef": 0.06
    }
  },
  "logging": {
    "log_level": "INFO"
  }
}
