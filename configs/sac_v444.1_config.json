{
  "model_name": "sac_v444.1",
  "version": "4.4.4.1",
  "algorithm": "sac",
  "total_timesteps": 10000,
  "description": "SAC v444.1: Balanced reward design with ensemble system",

  "training": {
    "algorithm": "sac",
    "data_config": {
      "data_path": "data/btc_jpy_yahoo_real_20251021_featured_corrected.csv",
      "validation_split": 0.2,
      "test_split": 0.1
    },
    "total_timesteps": 50000,
    "sac_hyperparameters": {
      "learning_rate": 3e-4,
      "batch_size": 256,
      "buffer_size": 1000000,
      "learning_starts": 1000,
      "tau": 0.005,
      "gamma": 0.99,
      "ent_coef": "auto_1.0",
      "target_entropy": "auto"
    },
    "environment": {
      "initial_balance": 10000,
      "transaction_cost": 0.0,
      "max_position_size": 1.0,
      "random_start": true,
      "use_continuous_actions": true,
      "feature_engineering": {
        "enabled": true,
        "adaptive_selection": true,
        "correlation_reduction": true,
        "correlation_threshold": 0.85,
        "max_features": 100
      },
      "market_regime_detection": {
        "enabled": true,
        "regime_window": 50,
        "trend_threshold": 0.02,
        "volatility_threshold": 0.15
      },
      "risk_management": {
        "dynamic_position_sizing": true,
        "max_drawdown_limit": 0.1
      },
      "multi_timeframe_integration": {
        "enabled": true,
        "timeframes": ["5m", "15m", "1h", "4h", "1d"],
        "primary_timeframe": "1h"
      }
    }
  },

  "reward_settings": {
    "base_profit_bonus_atr_coeff": 5.0,
    "base_profit_bonus_portfolio_coeff": 10.0,
    "base_action_penalty": 0.15,
    "loss_penalty_coeff": -1.0,
    "action_frequency_penalty": 0.0,
    "long_short_asymmetry": true,
    "risk_adjusted_bonus": true,
    "market_regime_penalty": true,
    "custom_reward_params": {
      "profit_bonus_multipliers": [1.0, 1.0, 1.0]
    },
    "action_bonuses": {
      "hold_penalty": 0.001,
      "transaction_penalty": -0.1
    },
    "risk_management": {
      "max_drawdown_penalty": -0.1,
      "volatility_penalty": -0.05
    },
    "reward_clipping": {
      "enabled": true,
      "min_reward": -10.0,
      "max_reward": 10.0
    }
  },

  "ensemble_system": {
    "enabled": true,
    "models": ["sac_v444.1_base", "sac_v444.1_bull", "sac_v444.1_bear"],
    "voting_mechanism": "majority_vote",
    "confidence_threshold": 0.6,
    "specializations": ["bull", "bear", "sideways"],
    "consensus_bonus": 0.2,
    "diversity_penalty": -0.1
  },

  "market_regimes": {
    "bull_high_vol": {"correlation_target": 0.3, "risk_multiplier": 1.2},
    "bull_low_vol": {"correlation_target": 0.2, "risk_multiplier": 0.8},
    "bear_high_vol": {"correlation_target": 0.25, "risk_multiplier": 1.5},
    "bear_low_vol": {"correlation_target": 0.15, "risk_multiplier": 1.0},
    "sideways": {"correlation_target": 0.05, "risk_multiplier": 0.7}
  },

  "features": {
    "basic_features": ["open", "high", "low", "close", "volume", "returns", "log_returns"],
    "technical_indicators": ["sma_20", "sma_50", "rsi", "volatility"],
    "regime_features": ["volatility_regime", "trend_regime", "momentum_regime", "regime_score", "regime_low_vol", "regime_high_vol", "regime_downtrend", "regime_uptrend", "regime_bearish", "regime_bullish"],
    "correlation_features": ["price_correlation_lag_1", "price_correlation_lag_5", "price_correlation_lag_10", "price_correlation_lag_20", "volume_price_correlation", "volatility_correlation", "market_beta"],
    "ensemble_features": ["ensemble_confidence_bull", "ensemble_confidence_bear", "ensemble_confidence_sideways", "ensemble_pred_hold", "ensemble_trend_strength"],
    "risk_adjusted_features": ["rsi_risk_adjusted_5", "macd_risk_adjusted_5", "bb_position_vol_adjusted_5", "momentum_risk_adjusted_5", "close_atr_normalized_5", "high_atr_normalized_5", "low_atr_normalized_5", "rsi_risk_adjusted_10", "macd_risk_adjusted_10", "bb_position_vol_adjusted_10", "momentum_risk_adjusted_10", "close_atr_normalized_10", "high_atr_normalized_10", "low_atr_normalized_10", "rsi_risk_adjusted_20", "macd_risk_adjusted_20", "bb_position_vol_adjusted_20", "momentum_risk_adjusted_20", "close_atr_normalized_20", "high_atr_normalized_20", "low_atr_normalized_20", "rsi_risk_adjusted_50", "macd_risk_adjusted_50", "bb_position_vol_adjusted_50", "momentum_risk_adjusted_50", "close_atr_normalized_50", "high_atr_normalized_50", "low_atr_normalized_50"],
    "market_features": ["price_impact", "order_flow_toxicity", "spread_proxy", "market_depth_proxy", "trading_intensity", "price_efficiency"],
    "padding_features": ["padding_noise_0", "padding_sine_1", "padding_cosine_2", "padding_trend_3", "padding_noise_4", "padding_sine_5", "padding_cosine_6", "padding_trend_7", "padding_noise_8", "padding_sine_9", "padding_cosine_10", "padding_trend_11", "padding_noise_12", "padding_sine_13", "padding_cosine_14", "padding_trend_15", "padding_noise_16", "padding_sine_17", "padding_cosine_18", "padding_trend_19", "padding_noise_20", "padding_sine_21", "padding_cosine_22", "padding_trend_23", "padding_noise_24", "padding_sine_25", "padding_cosine_26", "padding_trend_27", "padding_noise_28", "padding_sine_29", "padding_cosine_30", "padding_trend_31", "padding_noise_32", "padding_sine_33", "padding_cosine_34", "padding_trend_35", "padding_noise_36", "padding_sine_37", "padding_cosine_38", "padding_trend_39", "padding_noise_40", "padding_sine_41", "padding_cosine_42", "padding_trend_43", "padding_noise_44", "padding_sine_45", "padding_cosine_46", "padding_trend_47", "padding_noise_48", "padding_sine_49", "padding_cosine_50", "padding_trend_51", "padding_noise_52", "padding_sine_53", "padding_cosine_54"]
  },

  "validation": {
    "enabled": true,
    "validation_freq": 1000,
    "n_eval_episodes": 5,
    "deterministic_eval": true,
    "validation_threshold": 0.8
  },

  "logging": {
    "tensorboard_log": "./tensorboard/sac_v444.1",
    "verbose": 1,
    "log_interval": 100
  },

  "checkpoint": {
    "save_freq": 1000,
    "save_path": "./checkpoints",
    "save_replay_buffer": false
  }
}