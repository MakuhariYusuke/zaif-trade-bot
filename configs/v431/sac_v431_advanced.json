{
  "version": "v431",
  "description": "SAC v431: Advanced Learning Framework with Unified Analysis Integration",
  "algorithm": "sac",
  "reward_function": {
    "sell_bonus": 0.3,
    "hold_bonus": 0.001,
    "buy_bonus": 0.3
  },
  "action_thresholds": {
    "sell_threshold": -0.2,
    "buy_threshold": 0.2
  },
  "advanced_learning": {
    "curriculum": {
      "enabled": true,
      "stages": [
        {
          "name": "warmup",
          "timesteps": 20000,
          "learning_rate": 0.001
        },
        {
          "name": "foundation",
          "timesteps": 30000,
          "learning_rate": 0.0005
        },
        {
          "name": "optimization",
          "timesteps": 30000,
          "learning_rate": 0.000161
        },
        {
          "name": "refinement",
          "timesteps": 20000,
          "learning_rate": 0.00008
        }
      ]
    },
    "multi_stage": {
      "enabled": true,
      "stages": [
        {
          "name": "exploration",
          "timesteps": 40000,
          "focus": "high_entropy_exploration"
        },
        {
          "name": "exploitation",
          "timesteps": 40000,
          "focus": "optimal_policy_learning"
        },
        {
          "name": "fine_tuning",
          "timesteps": 20000,
          "focus": "policy_refinement"
        }
      ]
    },
    "ensemble": {
      "enabled": true,
      "members": 5,
      "specializations": ["bull", "bear", "sideways", "high_vol", "low_vol"],
      "voting": "weighted_confidence"
    }
  },
  "unified_analysis_integration": true,
  "training": {
    "total_timesteps": 100000,
    "learning_rate": 0.000161,
    "gamma": 0.98,
    "tau": 0.005,
    "ent_coef": "auto_0.01",
    "target_entropy": "auto",
    "batch_size": 512,
    "buffer_size": 100000,
    "learning_starts": 1000,
    "gradient_steps": 1,
    "train_freq": [1, "step"]
  }
}
