{
  "comment": "Ensemble C - 100k Test Run: Aggressive exploration, reverse禁止（コスト抱制）",
  "algorithm": "ppo",
  "data_path": "ml-dataset-enhanced.csv",
  "session_id": "ensemble_C_100k_test",
  "total_timesteps": 100000,

  "training": {
    "learning_rate": 3.0e-4,
    "n_steps": 2048,
    "batch_size": 64,
    "n_epochs": 10,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_range": 0.2,
    "ent_coef": 0.8,
    "ent_coef_schedule": "cosine_decay",
    "ent_coef_final": 0.2,
    "vf_coef": 0.5,
    "max_grad_norm": 0.5,
    "seed": 303
  },

  "custom_ppo": {
    "enable_pan": true,
    "enable_target_entropy": true,
    "enable_stratified_sampling": false,
    "target_entropy_ratio": 0.7,
    "lr_temperature": 3.0e-4,
    "initial_temperature": 0.01,
    "pan_epsilon": 1.0e-8
  },

  "environment": {
    "transaction_cost": 0.001,
    "max_position_size": 1.0,
    "curriculum_stage": "full",
    "allow_reverse": false
  },

  "reward_profit_bonus_multipliers": [1.0, 1.0, 1.0],
  "reward_settings": {
    "enable_forced_diversity": false
  },

  "checkpoint_interval": 10000,
  "checkpoint_dir": "checkpoints/ensemble_C_100k_test",
  "log_dir": "logs/ensemble_C_100k_test",
  "model_dir": "models/ensemble_C_100k_test",

  "verbose": 1,
  "enable_progress_bar": true,
  "staging": null,
  "offline_mode": false
}
