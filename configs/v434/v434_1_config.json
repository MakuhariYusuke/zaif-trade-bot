{
  "version": "1.0",
  "training": {
    "model_name": "v434_1_combined_learning_model",
    "algorithm": "sac",
    "total_timesteps": 10000,
    "data_config": {
      "csv_path": null,
      "use_real_data": true,
      "data_path": "data/btc_jpy_real_dataset.csv",
      "random_start": true,
      "min_samples": 10000
    },
    "environment": {
      "initial_balance": 200000.0,
      "transaction_cost": 1e-05,
      "max_position_size": 1.0,
      "enable_action_masking": true,
      "use_continuous_actions": true,
      "use_standardized_observations": true,
      "curriculum_stage": "balanced_trading",
      "continuous_to_discrete_threshold": 0.1,
      "reward_settings": {
        "use_simple_reward": false,
        "reward_scale": 100.0,
        "trading_bonus": 0.01,
        "profit_bonuses": {
          "small_profit": 0.001,
          "medium_profit": 0.005,
          "large_profit": 0.01
        },
        "penalty_coefficients": {
          "loss_penalty": -0.002,
          "large_loss_penalty": -0.01,
          "inactivity_penalty": -0.0001
        },
        "entropy_bonus": 0.001,
        "dynamic_reward_shaping": {
          "enabled": true,
          "market_regime_adaptation": true,
          "volatility_adjustment": true,
          "trend_strength_bonus": 0.005
        }
      }
    },
    "features": {
      "features": {},
      "feature_set": "default",
      "adaptive_feature_selection": {
        "enabled": true,
        "selection_method": "mutual_info",
        "top_k_features": 20,
        "update_frequency": 1000
      }
    },
    "sac_hyperparameters": {
      "learning_rate": 0.0003,
      "buffer_size": 1000000,
      "learning_starts": 1000,
      "batch_size": 256,
      "tau": 0.005,
      "gamma": 0.99,
      "ent_coef": 0.1,
      "target_update_interval": 1,
      "target_entropy": "auto",
      "train_freq": 1
    },
    "learning_strategies": {
      "curriculum_learning": {
        "enabled": true,
        "stages": [
          {"name": "basic_trading", "timesteps": 2000, "difficulty": 0.3},
          {"name": "intermediate_trading", "timesteps": 3000, "difficulty": 0.6},
          {"name": "advanced_trading", "timesteps": 5000, "difficulty": 1.0}
        ],
        "progression_criteria": {
          "min_reward_threshold": -20.0,
          "max_drawdown_limit": 0.1
        }
      },
      "market_regime_detection": {
        "enabled": true,
        "regimes": ["bull", "bear", "sideways", "volatile"],
        "detection_method": "clustering",
        "adaptation_frequency": 500
      },
      "ensemble_learning": {
        "enabled": true,
        "num_models": 3,
        "diversity_method": "parameter_noise",
        "weighting_method": "performance_based",
        "update_frequency": 1000
      },
      "online_learning": {
        "enabled": true,
        "update_frequency": 100,
        "concept_drift_detection": true,
        "adaptation_rate": 0.01
      }
    }
  },
  "evaluation": {
    "thresholds": {
      "re_evaluate": 0.05,
      "monitor": 0.01
    },
    "min_samples": 10000,
    "risk_metrics": [
      "sharpe",
      "sortino",
      "max_drawdown"
    ],
    "performance_metrics": [
      "total_return",
      "win_rate",
      "profit_factor"
    ]
  },
  "deployment": {
    "mode": "paper_trading",
    "paper_trading": {
      "enabled": true,
      "virtual_balance": 200000.0,
      "simulate_latency": true,
      "simulate_slippage": true,
      "market_data_source": "real"
    }
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file_path": null
  }
}
