{
  "model_name": "sac_v397_enhanced",
  "session_id": "sac_session",
  "algorithm": "sac",
  "total_timesteps": 50000,
  "metrics_log_interval": 100,
  "checkpoint_interval": 10000,
  
  "data_path": "btc_jpy_real_dataset.csv",
  
  "environment": {
    "initial_balance": 1000000,
    "commission_rate": 0.001,
    "price_column": "close",
    "use_continuous_actions": true,
    "enable_action_masking": false
  },
  
  "sac_hyperparameters": {
    "learning_rate": 0.000574,
    "batch_size": 128,
    "gamma": 0.9948,
    "tau": 0.005,
    "ent_coef": "auto",
    "target_update_interval": 3,
    "train_freq": 1,
    "gradient_steps": 1,
    "learning_starts": 100,
    "buffer_size": 50000,
    "policy_kwargs": {
      "net_arch": [256, 256]
    }
  },
  
  "enable_early_stopping": true,
  "early_stopping": {
    "metric": "critic_loss",
    "min_delta": 0.0001,
    "patience": 5000,
    "check_interval": 1000,
    "window_size": 1000,
    "cv_threshold": 0.05
  },
  
  "enable_best_model_saving": true,
  "best_model": {
    "metric": "critic_loss",
    "mode": "min",
    "check_interval": 1000
  },
  
  "notes": {
    "version": "v397 - Enhanced with Advanced Features",
    "improvements": [
      "✅ CSV metrics with enhanced fields (episode rewards, Q-values)",
      "✅ TensorBoard direct write (100 steps interval)",
      "✅ Early Stopping (convergence detection)",
      "✅ Best Model auto-saving",
      "✅ Extended metrics: episode_reward, episode_length, q_values"
    ],
    "expected_early_stop": "25,000-35,000 steps (based on v396 analysis)",
    "expected_duration": "~20-25 minutes (with early stopping)",
    "expected_critic_loss": "< 0.001",
    "output_files": {
      "model_final": "checkpoints/sac_session/sac_v397_enhanced_final.zip",
      "model_best": "checkpoints/sac_session/best_models/sac_v397_enhanced_best_*.zip",
      "csv_metrics": "checkpoints/sac_session/sac_v397_enhanced_training_metrics.csv",
      "tensorboard": "checkpoints/sac_session/SAC_*"
    },
    "csv_columns": [
      "timestamp", "step",
      "critic_loss", "actor_loss", "ent_coef", "ent_coef_loss", "learning_rate", "fps",
      "episode_reward_mean", "episode_reward_std", "episode_length_mean",
      "q_value_mean", "q_value_std", "q_value_min", "q_value_max",
      "total_episodes"
    ]
  }
}
