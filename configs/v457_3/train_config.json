{
    "training": {
        "total_timesteps": 10000,
        "environment": {
            "initial_balance": 1000000.0,
            "transaction_cost": 0.001,
            "max_position_size": 1.0,
            "reward_scale": 1.0,
            "reward_clip": 10.0,
            "reward_settings": {
                "alpha": 1.0,
                "fee_penalty_weight": 0.0,
                "holding_penalty": 0.0,
                "edge_penalty_rate": 0.0,
                "vol_floor": 0.0005
            }
        },
        "sac_hyperparameters": {
            "ent_coef": "auto",
            "learning_rate": 0.0003,
            "batch_size": 256
        },
        "callbacks": {
            "early_stopping_patience": 50000,
            "best_model": {
                "metric_name": "rollout/ep_rew_mean",
                "mode": "max",
                "check_interval": 1000
            }
        }
    }
}