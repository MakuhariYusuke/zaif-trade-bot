{
  "version": "1.0",
  "algorithm": "sac",
  "model_name": "sac_v454_phaseC_tuned",
  "logging_level": "WARNING",
  "description": "SAC v454 Phase C: Tuned Regime Thresholds for Trend Detection",
  "regime_adaptation": {
    "enabled": true,
    "regime_classifier_config": {
      "regime_scheme": "comprehensive",
      "use_multi_timeframe": true,
      "confidence_threshold": 0.6
    },
    "adaptation_rules": {
      "hyperparameter_adjustment": true,
      "reward_scaling": true,
      "exploration_adjustment": true
    },
    "regime_specific_params": {
      "strong_bull": {
        "ent_coef": 0.01,
        "learning_rate": 0.0003,
        "reward_scale": 1.2
      },
      "strong_bear": {
        "ent_coef": 0.01,
        "learning_rate": 0.0003,
        "reward_scale": 1.2
      },
      "high_volatility_range": {
        "ent_coef": 0.05,
        "learning_rate": 0.0005,
        "reward_scale": 0.8
      },
      "consolidation": {
        "ent_coef": 0.02,
        "learning_rate": 0.0001,
        "reward_scale": 1.5
      }
    },
    "adaptation_frequency": 100,
    "performance_tracking_window": 1000
  },
  "training": {
    "algorithm": "sac",
    "model_name": "sac_v454_phaseC_tuned",
    "total_timesteps": 10000,
    "data_config": {
      "csv_path": "data/btc_jpy_1m_v454.csv",
      "data_path": "data/btc_jpy_1m_v454.csv",
      "use_real_data": true,
      "validation_split": 0.2
    },
    "sac_hyperparameters": {
      "learning_rate": 0.0003,
      "buffer_size": 100000,
      "learning_starts": 1000,
      "batch_size": 256,
      "tau": 0.005,
      "gamma": 0.99,
      "ent_coef": "auto",
      "target_update_interval": 1,
      "target_entropy": "auto"
    }
  },
  "features": {
      "feature_set": "high_quality"
    },
    "environment": {
      "feature_set": "high_quality",
      "initial_balance": 1000000.0,
      "commission": 0.001,
      "max_position_size": 1.0,
      "reward_scaling": 1.0,
      "action_space_type": "continuous",
      "use_continuous_actions": true,
      "target_feature_count": 166,
      "curriculum_stage": "advanced_regime_adaptation",
      "continuous_to_discrete_threshold": 0.5,
      "adaptive_threshold_mode": true,
      "threshold_volatility_multiplier": 1.0,
      "risk_management": {
        "min_trade_size": 0.0001,
        "take_profit_pct": 0.0
      },
      "behavior_optimization": {
        "action_balance_target": 0.35,
        "entropy_regularization": 0.01,
        "action_smoothing": 0.1,
        "consistency_penalty": 0.05,
        "balance_penalty": 1.0
      },
      "hybrid_config": {
        "enabled": true,
        "time_filter": {
          "enabled": false,
          "excluded_hours": [
            1,
            14,
            17
          ]
        },
        "regime_filter": {
          "enabled": true,
          "mode": "soft",
          "force_exit": true,
          "excluded_regimes": [],
          "regime_constraints": {
            "weak_bull_trend": {
              "action_permission": "restricted",
              "position_multiplier": 0.2,
              "allowed_entry_actions": [
                "buy"
              ],
              "entry_action_source": "pullback",
              "exit_action_source": "tp_sl",
              "entry_zscore_threshold": 0.0,
              "stop_loss_pct": 0.01,
              "take_profit_pct": 0.02
            },
            "moderate_bull_trend": {
              "action_permission": "restricted",
              "position_multiplier": 0.2,
              "allowed_entry_actions": [
                "buy"
              ],
              "entry_action_source": "pullback",
              "exit_action_source": "tp_sl",
              "entry_zscore_threshold": 0.0,
              "stop_loss_pct": 0.01,
              "take_profit_pct": 0.02
            },
            "strong_bull_trend": {
              "action_permission": "restricted",
              "position_multiplier": 0.2,
              "allowed_entry_actions": [
                "buy"
              ],
              "entry_action_source": "pullback",
              "exit_action_source": "tp_sl",
              "entry_zscore_threshold": 0.0,
              "stop_loss_pct": 0.01,
              "take_profit_pct": 0.02
            },
            "weak_bear_trend": {
              "action_permission": "restricted",
              "position_multiplier": 0.2,
              "allowed_entry_actions": [
                "sell"
              ],
              "entry_action_source": "pullback",
              "exit_action_source": "tp_sl",
              "entry_zscore_threshold": 0.0,
              "stop_loss_pct": 0.01,
              "take_profit_pct": 0.02
            },
            "moderate_bear_trend": {
              "action_permission": "restricted",
              "position_multiplier": 0.2,
              "allowed_entry_actions": [
                "sell"
              ],
              "entry_action_source": "pullback",
              "exit_action_source": "tp_sl",
              "entry_zscore_threshold": 0.0,
              "stop_loss_pct": 0.01,
              "take_profit_pct": 0.02
            },
            "strong_bear_trend": {
              "action_permission": "restricted",
              "position_multiplier": 0.2,
              "allowed_entry_actions": [
                "sell"
              ],
              "entry_action_source": "pullback",
              "exit_action_source": "tp_sl",
              "entry_zscore_threshold": 0.0,
              "stop_loss_pct": 0.01,
              "take_profit_pct": 0.02
            }
          }
        },
        "trend_filter": {
          "enabled": false,
          "min_trend_strength": 0.0,
          "multiplier": 1.0
        }
      },
      "advanced_market_regime": {
        "enabled": true,
        "regime_detection_window": 20,
        "adaptation_frequency": 5,
        "multi_timeframe_confirmation": true,
        "dynamic_thresholds": true,
        "regime_classifier_config": {
          "thresholds": {
            "moderate_volatility_threshold": 0.002,
            "high_volatility_threshold": 0.005,
            "extreme_volatility_threshold": 0.015
          }
        }
      }
    }
}
