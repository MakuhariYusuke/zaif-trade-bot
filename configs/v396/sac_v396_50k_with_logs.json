{
  "model_name": "sac_v396_50k_with_logs",
  "session_id": "sac_session",
  "algorithm": "sac",
  "total_timesteps": 50000,
  "metrics_log_interval": 100,
  "checkpoint_interval": 10000,
  "data_path": "btc_jpy_real_dataset.csv",
  "environment": {
    "initial_balance": 1000000.0,
    "commission_rate": 0.001,
    "price_column": "close",
    "use_continuous_actions": true,
    "enable_action_masking": false
  },
  "sac_hyperparameters": {
    "learning_rate": 0.000574,
    "batch_size": 128,
    "gamma": 0.9948,
    "tau": 0.005,
    "ent_coef": "auto",
    "target_update_interval": 3,
    "train_freq": 1,
    "gradient_steps": 1,
    "learning_starts": 100,
    "buffer_size": 50000,
    "policy_kwargs": {
      "net_arch": [
        256,
        256
      ]
    }
  },
  "notes": {
    "purpose": "SAC v396 50k steps with improved logging system",
    "improvements": [
      "CSV metrics file: 100 steps interval",
      "TensorBoard direct write: 100 steps interval",
      "Stdout progress: 100 steps interval",
      "Expected CSV rows: ~500 (step 100, 200, ..., 50000)"
    ],
    "expected_duration": "~35-40 minutes",
    "expected_critic_loss": "< 0.001",
    "output_files": {
      "model": "checkpoints/sac_session/sac_v396_50k_with_logs_final.zip",
      "csv_metrics": "checkpoints/sac_session/sac_v396_50k_with_logs_training_metrics.csv",
      "tensorboard": "checkpoints/sac_session/SAC_*",
      "final_metrics_json": "checkpoints/sac_session/sac_v396_50k_with_logs_final_metrics.json"
    }
  }
}
