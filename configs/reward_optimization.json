  "constraints": {
    "max_drawdown_limit": 0.3,
    "min_sharpe_ratio": 0.5,
    "max_volatility": 0.5,
    "min_win_rate": 0.4,
    "max_correlation_with_benchmark": 0.8
  },
  "reporting": {
    "generate_plots": true,
    "plot_types": ["optimization_history", "parameter_importance", "pareto_front"],
    "save_intermediate_results": true,
    "intermediate_save_frequency": 10
  }
