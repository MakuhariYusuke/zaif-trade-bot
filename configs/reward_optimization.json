{
  "optimization": {
    "default_n_trials": 100,
    "default_objectives": ["profit", "sharpe", "win_rate", "consistency"],
    "early_stopping": {
      "enabled": true,
      "patience": 20,
      "min_trials": 50
    },
    "parallelization": {
      "enabled": true,
      "n_jobs": -1
    }
  },
  "evaluation": {
    "evaluation_episodes": 10,
    "max_steps_per_episode": 1000,
    "market_conditions": ["bull", "bear", "sideways", "volatile"],
    "risk_free_rate": 0.02,
    "benchmark_return": 0.05,
    "consistency_window": 50,
    "min_trades_for_evaluation": 10,
    "cross_validation": {
      "enabled": true,
      "n_folds": 5,
      "test_size": 0.2
    }
  },
  "parameter_spaces": {
    "balanced_transition": {
      "balance_penalty_tolerance": {
        "type": "float",
        "low": 0.01,
        "high": 0.2,
        "log_scale": false,
        "description": "Tolerance for balance deviation before penalty"
      },
      "balance_penalty": {
        "type": "float",
        "low": 1.0,
        "high": 20.0,
        "log_scale": false,
        "description": "Penalty multiplier for balance deviation"
      },
      "hold_penalty_rate": {
        "type": "float",
        "low": 0.001,
        "high": 0.1,
        "log_scale": true,
        "description": "Penalty rate for holding positions"
      },
      "trading_bonus_multiplier": {
        "type": "float",
        "low": 1.0,
        "high": 5.0,
        "log_scale": false,
        "description": "Multiplier for trading bonuses"
      },
      "trading_bonus": {
        "type": "float",
        "low": 0.001,
        "high": 0.1,
        "log_scale": true,
        "description": "Base trading bonus"
      },
      "profit_weight": {
        "type": "float",
        "low": 0.1,
        "high": 2.0,
        "log_scale": false,
        "description": "Weight for profit component"
      },
      "risk_weight": {
        "type": "float",
        "low": 0.1,
        "high": 2.0,
        "log_scale": false,
        "description": "Weight for risk component"
      },
      "consistency_weight": {
        "type": "float",
        "low": 0.1,
        "high": 2.0,
        "log_scale": false,
        "description": "Weight for consistency component"
      }
    },
    "trading_focused": {
