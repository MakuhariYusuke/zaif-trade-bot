{
  "model_name": "sac_v422b_prototypical",
  "algorithm": "sac",
  "total_timesteps": 150000,
  "data_source": "csv",
  "data_path": "data/btc_jpy_real_dataset.csv",
  "data_config": {
    "csv_path": "btc_jpy_real_dataset.csv",
    "use_real_data": true
  },
  "sac_hyperparameters": {
    "learning_rate": 0.0003,
    "buffer_size": 150000,
    "learning_starts": 100,
    "batch_size": 32,
    "tau": 0.01,
    "gamma": 0.99,
    "train_freq": 1,
    "gradient_steps": 1,
    "ent_coef": "auto",
    "target_update_interval": 2,
    "target_entropy": -2.0
  },
  "environment": {
    "initial_balance": 1000000.0,
    "transaction_cost": 0.001,
    "max_position_size": 0.1,
    "enable_action_masking": false,
    "use_continuous_actions": true,
    "use_standardized_observations": true,
    "random_start": true,
    "curriculum_stage": "prototypical_optimization",
    "continuous_to_discrete_threshold": 0.05
  },
  "reward_settings": {
    "reward_scale": 1000.0,
    "reward_clip_min": -10.0,
    "reward_clip_max": 10.0,
    "profit_bonuses": {
      "base_profit_atr_coefficient": 1.5,
      "base_profit_portfolio_coefficient": 1.2,
      "profit_multipliers": [2.0, 0.6, 0.4],
      "trading_bonus": 0.01,
      "trading_bonus_multiplier": 4.0
    },
    "action_bonuses": {
      "buy_action_bonus": -0.01,
      "sell_action_bonus": 0.02,
      "hold_action_bonus": 0.01,
      "win_rate_bonus": 0.1,
      "momentum_bonus": 0.05,
      "diversity_bonus": 0.02
    },
    "behavior_penalties": {
      "loss_penalty_multiplier": 3.0,
      "balance_penalty": 3.0,
      "balance_penalty_tolerance": 0.05,
      "action_frequency_penalty": 0.005,
      "inactivity_penalty_rate": 0.00005,
      "opportunity_cost_rate": 0.00005
    },
    "risk_penalties": {
      "volatility_penalty": 0.02,
      "position_penalty_soft_cap": 0.8,
      "constraint_penalty": 1.0
    },
    "flags": {
      "enable_forced_diversity": false,
      "enable_inactivity_penalty": true,
      "enable_opportunity_cost": false,
      "enable_trade_execution_bonus": true
    }
  },
  "fewshot_learning": {
    "enabled": true,
    "method": "prototypical",
    "n_way": 5,
    "k_shot": 1,
    "query_shots": 3,
    "meta_batch_size": 8,
    "num_episodes_per_epoch": 200,
    "validation_episodes": 100,
    "inner_learning_rate": 0.1,
    "meta_learning_rate": 0.001,
    "num_inner_steps": 3,
    "distance_metric": "euclidean",
    "enable_prototypical": true,
    "enable_matching": false,
    "enable_maml": false,
    "prototypical_config": {
      "embedding_dim": 64,
      "use_cosine_distance": false,
      "temperature": 1.0,
      "margin": 1.0
    }
  },
  "checkpoint_interval": 15000,
  "notes": "SAC v422b: Prototypical Networks Specialization - 1-shot learning optimization",
  "fixes_implemented": {
    "feature_1": "Prototypical Networks with Euclidean distance for 1-shot tasks",
    "feature_2": "Optimized embedding dimensions (64) for memory efficiency",
    "feature_3": "Meta-batch size 8 for stable training convergence",
    "feature_4": "Specialized early stopping for few-shot accuracy metrics"
  }
}