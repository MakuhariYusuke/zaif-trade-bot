{
  "version": "1.0",
  "algorithm": "ppo",
  "model_name": "ppo_v443_2_backtest_optimization",
  "behavior_optimization": {
    "action_balance_target": 0.8,
    "entropy_regularization": 0.01,
    "action_smoothing": 0.1,
    "consistency_penalty": 0.05,
    "balance_penalty": 1.0
  },
  "training": {
    "algorithm": "ppo",
    "model_name": "ppo_v443_2_backtest_optimization",
    "total_timesteps": 25000,
    "data_config": {
      "csv_path": "data/btc_jpy_real_dataset.csv",
      "data_path": "data/btc_jpy_real_dataset.csv",
      "use_real_data": true,
      "validation_split": 0.2
    },
    "environment": {
      "config": {
        "initial_balance": 200000.0,
        "commission": 0.001,
        "max_position_size": 1.0,
        "reward_scaling": 1.0,
        "curriculum_stage": "backtest_optimization",
        "continuous_to_discrete_threshold": 0.08,
        "behavior_optimization": {
          "action_balance_target": 0.8,
          "entropy_regularization": 0.01,
          "action_smoothing": 0.1,
          "consistency_penalty": 0.05,
          "balance_penalty": 1.0
        },
        "market_regime": {
          "enabled": true,
          "regime_detection_window": 20,
          "adaptation_frequency": 10,
          "regime_adaptive_behavior": {
            "bull_market": {
              "action_balance_target": 0.75,
              "entropy_regularization": 0.005,
              "consistency_penalty": 0.03,
              "balance_penalty": 0.8
            },
            "bear_market": {
              "action_balance_target": 0.85,
              "entropy_regularization": 0.015,
              "consistency_penalty": 0.08,
              "balance_penalty": 1.2
            },
            "sideways_market": {
              "action_balance_target": 0.8,
              "entropy_regularization": 0.01,
              "consistency_penalty": 0.05,
              "balance_penalty": 1.0
            },
            "volatile_market": {
              "action_balance_target": 0.7,
              "entropy_regularization": 0.02,
              "consistency_penalty": 0.02,
              "balance_penalty": 0.5
            }
          }
        },
        "dynamic_reward_shaping": {
          "enabled": true,
          "market_regime_awareness": true,
          "volatility_adjusted_rewards": true,
          "trend_strength_bonus": true,
          "regime_detection_window": 20,
          "adaptation_frequency": 10,
          "regime_coefficients": {
            "bull_market_bonus_coeff": 1.2,
            "bear_market_penalty_coeff": 0.8,
            "sideways_market_penalty_coeff": 0.9,
            "volatile_market_bonus_coeff": 1.1
          },
          "volatility_coefficients": {
            "high_volatility_threshold": 0.02,
            "low_volatility_threshold": 0.005,
            "high_volatility_bonus": 1.3,
            "low_volatility_penalty": 0.7
          },
          "trend_coefficients": {
            "trend_strength_threshold": 0.001,
            "strong_trend_bonus": 1.2,
            "weak_trend_penalty": 0.8
          }
        }
      }
    },
    "features": {
      "feature_set": "v438_extended",
      "include_regime_indicators": true,
      "include_volatility_features": true,
      "include_momentum_features": true
    },
    "ppo_hyperparameters": {
      "learning_rate": 0.00025,
      "n_steps": 2048,
      "batch_size": 512,
      "n_epochs": 10,
      "gamma": 0.995,
      "gae_lambda": 0.95,
      "clip_range": 0.2,
      "ent_coef": 0.01,
      "vf_coef": 0.5,
      "max_grad_norm": 0.5,
      "verbose": 1
    }
  }
}
