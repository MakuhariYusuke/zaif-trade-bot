{
  "model_name": "sac_v395h_normalized",
  "algorithm": "sac",
  "total_timesteps": 5000,
  "data_source": "csv",
  "data_path": "btc_jpy_real_dataset.csv",
  "data_config": {
    "csv_path": "btc_jpy_real_dataset.csv",
    "use_real_data": true
  },
  "sac_hyperparameters": {
    "learning_rate": 0.0003,
    "buffer_size": 20000,
    "learning_starts": 500,
    "batch_size": 128,
    "tau": 0.005,
    "gamma": 0.99,
    "train_freq": 1,
    "gradient_steps": 1,
    "ent_coef": "auto",
    "target_update_interval": 1,
    "target_entropy": "auto"
  },
  "environment": {
    "initial_balance": 200000.0,
    "transaction_cost": 0.0005,
    "max_position_size": 0.01,
    "enable_action_masking": false,
    "use_continuous_actions": true,
    "use_standardized_observations": true,
    "random_start": true,
    "reward_settings": {
      "use_simple_reward": true,
      "reward_scale": 100.0,
      "reward_clip_min": -1.0,
      "reward_clip_max": 1.0,
      "enable_inactivity_penalty": true,
      "inactivity_penalty_rate": 0.001,
      "enable_opportunity_cost": true,
      "opportunity_cost_rate": 0.0005
    }
  },
  "checkpoint_interval": 1000,
  "notes": "SAC v395h: Fix root causes found in environment diagnostics",
  "fixes_from_diagnostics": {
    "problem_1": "Observations not normalized (max value: 18 million)",
    "solution_1": "Enable use_standardized_observations = true",
    "expected_result_1": "All features scaled to mean=0, std=1",
    "problem_2": "Zero rewards: 64.3% (insufficient learning signal)",
    "solution_2": "Add inactivity_penalty and opportunity_cost for HOLD actions",
    "expected_result_2": "Reduce zero rewards to < 30%",
    "diagnostic_findings": {
      "observations_mean_range": [
        0.0,
        18111058.0
      ],
      "observations_std_range": [
        0.0,
        1902.35
      ],
      "large_std_features": 26,
      "zero_rewards_pct": 64.3,
      "reward_mean": -0.031,
      "reward_std": 0.042
    },
    "expected_improvements": {
      "critic_loss": "< 1000 (was 1e7-1e10)",
      "actor_loss": "0.1 to 100 (was 1e6)",
      "ent_coef": "0.5 to 1.5 (was 3.58)",
      "observations_std_max": "< 5.0 (was 1902.35)",
      "zero_rewards_pct": "< 30% (was 64.3%)"
    }
  }
}
