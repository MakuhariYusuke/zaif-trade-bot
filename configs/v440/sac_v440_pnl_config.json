{
  "version": "4.4.0",
  "model_name": "sac_v440_pnl_focused",
  "description": "SAC v440 - Pure PnL-Based Trading Model (Simplified Approach)",

  "training": {
    "total_timesteps": 100000,
    "learning_rate": 3e-4,
    "batch_size": 256,
    "buffer_size": 1000000,
    "learning_starts": 1000,
    "tau": 0.005,
    "gamma": 0.99,
    "ent_coef": "auto_1.0",
    "target_entropy": "auto",
    "algorithm": "sac"
  },

  "environment": {
    "initial_balance": 10000.0,
    "max_steps": 1000,
    "commission": 0.001,
    "slippage": 0.0005,
    "max_position_size": 1.0,
    "min_trade_size": 0.001,
    "reward_scaling": 1000.0,
    "reward_clip_value": 10.0,
    "continuous_to_discrete_threshold": 0.3333,
    "continuous_to_discrete_threshold_neg": -0.3333,
    "random_start": true,
    "feature_set": "full",
    "curriculum_stage": "basic"
  },

  "reward_function": {
    "use_simple_reward": true,
    "base_profit_bonus": 1.0,
    "loss_penalty_coeff": -1.0,
    "action_penalty": 0.0,
    "hold_penalty_multiplier": 1.01,
    "trade_frequency_bonus": 0.001,
    "max_trades_per_episode": 50,
    "target_action_rate": 0.5,
    "scalping_mode": false,
    "signal_guidance_integration": false,
    "risk_adjusted_bonus": false,
    "market_regime_penalty": false,
    "long_short_asymmetry": false
  },

  "features": {
    "technical_indicators": [
      "rsi_14",
      "macd",
      "macd_signal",
      "macd_hist",
      "bb_upper",
      "bb_middle",
      "bb_lower",
      "bb_position",
      "sma_5",
      "sma_10",
      "sma_20",
      "volatility_10",
      "volume_sma_5",
      "high_low_range"
    ],
    "price_features": [
      "returns",
      "log_returns",
      "open",
      "high",
      "low",
      "close",
      "volume"
    ],
    "volatility_features": [
      "volatility_10"
    ],
    "volume_features": [
      "volume_sma_5"
    ],
    "momentum_features": [
      "macd",
      "macd_signal",
      "macd_hist"
    ],
    "trend_features": [
      "sma_5",
      "sma_10",
      "sma_20",
      "bb_upper",
      "bb_middle",
      "bb_lower"
    ],
    "oscillator_features": [
      "rsi_14",
      "bb_position"
    ],
    "support_resistance": [],
    "exclude_multi_timeframe": false,
    "target_dimensions": 110
  },

  "feature_names": [
    "rsi_14",
    "macd",
    "bb_upper",
    "bb_middle",
    "bb_lower",
    "stoch_k",
    "stoch_d",
    "returns",
    "log_returns",
    "volatility_10",
    "balance_norm",
    "position",
    "unrealized_norm"
  ],

  "output": {
    "model_dir": "models/v440",
    "config_dir": "config/v440",
    "results_dir": "results/v440",
    "tensorboard_log": "tensorboard/v440"
  },

  "evaluation": {
    "thresholds": {
      "re_evaluate": 0.05,
      "monitor": 0.01
    },
    "min_samples": 10000,
    "risk_metrics": ["sharpe", "sortino", "max_drawdown"],
    "performance_metrics": ["total_return", "win_rate", "profit_factor", "trade_frequency"]
  }
}