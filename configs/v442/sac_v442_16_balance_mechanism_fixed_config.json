{
  "version": "1.0",
  "algorithm": "sac",
  "model_name": "sac_v442_16_balance_mechanism_fixed_trading",
  "training": {
    "total_timesteps": 10000,
    "algorithm": "SAC",
    "sac_hyperparameters": {
      "learning_rate": 3e-4,
      "buffer_size": 1000000,
      "learning_starts": 1000,
      "batch_size": 256,
      "tau": 0.005,
      "gamma": 0.99,
      "train_freq": 1,
      "gradient_steps": 1,
      "target_update_interval": 1,
      "ent_coef": "auto",
      "ent_coef_init": 1.0
    },
    "environment": {
      "type": "TradingEnvironment",
      "config": {
        "reward_scaling": 1.0,
        "use_continuous_actions": true,
        "continuous_to_discrete_threshold": 0.3333,
        "continuous_to_discrete_threshold_neg": -0.3333,
        "curriculum_stage": "stability_optimized",
        "behavior_optimization": {
          "action_balance_target": 0.4,
          "entropy_regularization": 0.0,
          "action_smoothing": 0.15,
          "consistency_penalty": 0.01,
          "balance_penalty": 0.0
        }
      }
    }
  },
  "features": {
    "type": "V4FeatureExtractor",
    "config": {
      "feature_columns": [
        "close", "volume", "returns", "volatility",
        "rsi", "macd", "bb_upper", "bb_lower",
        "stoch_k", "stoch_d", "williams_r",
        "cci", "mfi", "trix", "kama"
      ],
      "sequence_length": 60,
      "prediction_horizon": 1
    }
  },
  "evaluation": {
    "eval_freq": 1000,
    "eval_episodes": 5,
    "deterministic": true
  }
}
