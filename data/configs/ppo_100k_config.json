{
  "comment": "100k training with binary-search optimized PPO + Lagrange parameters (2025-10)",
  "algorithm": "ppo",
  "data_path": "ml-dataset-enhanced.csv",
  "total_timesteps": 100000,
  "learning_rate": 0.009375625,
  "n_steps": 1024,
  "batch_size": 64,
  "n_epochs": 16,
  "gamma": 0.8475,
  "ent_coef": 0.02575,
  "vf_coef": 0.1,
  "max_grad_norm": 0.5,
  "clip_range": 0.3,
  "gae_lambda": 0.95,
  "target_kl": 0.1,
  "normalize_advantage": true,
  "seed": 42,

  "environment": {
    "transaction_cost": 0.001,
    "max_position_size": 1.0,
    "curriculum_stage": "full",
    "allow_reverse": false
  },

  "mitigation": {
    "enable_lagrange": true,
  "lagrange_warmup_steps": 3874,
  "lagrange_r_target": 0.175,
  "lagrange_tolerance": 0.042625,
  "lagrange_eta": 0.062875,
  "lagrange_lambda_max": 3.875,
    "enable_probes": false,
    "enable_weights": false,
    "enable_pan": true,
    "enable_target_entropy": false,
    "enable_stratified_sampling": false
  },

  "validation": {
    "target_sell_rate_min": 0.12,
    "target_sell_rate_optimal": 0.175,
    "grad_norm_threshold": 1e-6,
    "moving_window": 5000
  },

  "output": {
    "checkpoint_dir": "./checkpoints/ppo_100k_optimized",
    "tensorboard_log": "./logs/ppo_100k_optimized",
    "probe_csv": "./checkpoints/ppo_100k_optimized/sell_probe.csv"
  }
}
